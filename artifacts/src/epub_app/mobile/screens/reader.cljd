(ns epub-app.mobile.screens.reader
  "Mobile reader screen — Traditional Mongolian book reading"
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [cljd.flutter :as f]
            [epub-app.services.epub-core :as core]
            [epub-app.state.store :as store]
            [epub-app.theme :as t]
            [epub-app.widgets.page :as page]
            [epub-app.widgets.ui :as ui]))

;; TOC list tile
(defn- toc-tile [item]
  (mgl/MongolListTile
   .contentPadding (m/EdgeInsets.symmetric .horizontal 10.0 .vertical 8.0)
   .shape (m/RoundedRectangleBorder
           .borderRadius (m/BorderRadius.circular t/radius-s))
   .tileColor (t/surface)
   .title (ui/text (.-title item) {:size 16.0 :weight m.FontWeight/w500})
   .onTap (fn [] (core/open-toc-href! (.-href item)))))

;; TOC list
(defn- toc-list [items]
  (m/ListView
   .scrollDirection m.Axis/horizontal
   .padding (m/EdgeInsets.symmetric .horizontal 12.0 .vertical 16.0)
   .children
   (vec (mapcat (fn [item]
                  (cons (toc-tile item)
                        (map toc-tile (.-children item))))
                items))))

;; Vertical icon column helper
(defn- icon-col [icons]
  (m/Column
   .mainAxisSize m.MainAxisSize/min
   .children icons))

;; Left chrome bar (back + title + reader tools)
(defn- left-bar [book]
  (m/Positioned
   .top 0.0 .bottom 0.0 .left 0.0 .width t/chrome-width
   .child
   (ui/frosted
    (m/SafeArea
     .right false
     .child
     (m/Column
      .children
      [(ui/icon-btn m.Icons/arrow_back_rounded
                    (fn [] (core/close-book!))
                    :tooltip "Back to library"
                    :size 22.0)
       (ui/gap-v 4)
       (m/Expanded
        .child
        (m/Padding
         .padding (m/EdgeInsets.symmetric .horizontal 6.0 .vertical 10.0)
         .child
         (ui/text (or (some-> book .-title) "")
                  {:size 15.0 :weight m.FontWeight/w600 :max-lines 2})))
       (icon-col
        [(ui/icon-btn m.Icons/list_rounded
                      (fn [] (store/toggle-ui! :toc-visible))
                      :tooltip "Contents")
         (ui/icon-btn m.Icons/bookmarks_outlined
                      (fn [] (store/toggle-ui! :bookmarks-visible))
                      :tooltip "Bookmarks")
         (ui/icon-btn m.Icons/notes_outlined
                      (fn [] (store/toggle-ui! :notes-visible))
                      :tooltip "Notes")
         (ui/icon-btn m.Icons/bookmark_add_outlined
                      (fn [] (core/add-bookmark!))
                      :tooltip "Add bookmark")
         (ui/icon-btn m.Icons/search_rounded
                      (fn [] (store/toggle-ui! :search-visible))
                      :tooltip "Search")
         (ui/icon-btn m.Icons/tune_rounded
                      (fn [] (store/toggle-ui! :settings-visible))
                      :tooltip "Settings")])]))
    :elevation 8.0 :opacity 0.88)))

;; Right chrome bar (prev/next page + progress info)
(defn- right-bar [state]
  (m/Positioned
   .top 0.0 .bottom 0.0 .right 0.0 .width t/chrome-width
   .child
   (ui/frosted
    (m/SafeArea
     .left false
     .child
     (m/Column
      .children
      [(ui/icon-btn m.Icons/chevron_left_rounded
                    (fn [] (core/previous-page!))
                    :tooltip "Previous page"
                    :size 26.0)
       (ui/gap-v 8)
       (m/Expanded
        .child
        (m/Padding
         .padding (m/EdgeInsets.symmetric .horizontal 6.0 .vertical 10.0)
         .child
         (m/Column
          .mainAxisAlignment m.MainAxisAlignment/center
          .children
          [(ui/text
            (str (inc (:page state)) " / " (count (:pages state)))
            {:size 14.0 :color (t/ink-muted) :weight m.FontWeight/w500})
           (ui/gap-v 8)
           (ui/text
            (or (some-> (:chapter state) .-title) "")
            {:size 12.0 :color (t/ink-faint) :max-lines 2})])))
       (ui/gap-v 8)
       (ui/icon-btn m.Icons/chevron_right_rounded
                    (fn [] (core/next-page!))
                    :tooltip "Next page"
                    :size 26.0)]))
    :elevation 8.0 :opacity 0.88)))

;; Pill selector for settings options
(defn- setting-pills [value options on-pick]
  (m/Column
   .mainAxisSize m.MainAxisSize/min
   .children
   (mapv (fn [[id label]]
           (ui/pill {:label label
                     :active? (= id value)
                     :on-tap #(on-pick id)}))
         options)))

;; Inline reader settings panel (right-side overlay)
(defn- settings-panel [settings]
  (ui/side-sheet
   :right t/side-panel-width
   (m/SafeArea
    .child
    (m/Column
     .children
     [(m/Padding
       .padding (m/EdgeInsets.fromLTRB 16.0 20.0 16.0 12.0)
       .child
       (m/Row
        .children
        [(t/mongol-label "ᠲᠣᠬᠢᠷᠠᠭᠤᠯᠬᠤ" {:size 20.0 :weight m.FontWeight/bold})
         (m/Spacer)
         (ui/icon-btn m.Icons/close_rounded
                      (fn [] (store/set-ui! :settings-visible false))
                      :size 22.0)]))
      (ui/divider :margin (m/EdgeInsets.symmetric .horizontal 16.0))
      (m/Expanded
       .child
       (m/SingleChildScrollView
        .scrollDirection m.Axis/horizontal
        .padding (m/EdgeInsets.all 20.0)
        .child
        (m/Row
         .crossAxisAlignment m.CrossAxisAlignment/start
         .children
         [(m/Column
           .mainAxisSize m.MainAxisSize/min
           .children
           [(ui/v-slider 14.0 40.0 (:font-size settings)
                         (fn [v] (store/update-settings! :font-size v))
                         :label "Size")
            (ui/gap-v 24)])
          (ui/gap-h 20)
          (m/Column
           .mainAxisSize m.MainAxisSize/min
           .children
           [(ui/v-slider 1.2 2.8 (:line-height settings)
                         (fn [v] (store/update-settings! :line-height v))
                         :label "Height")
            (ui/gap-v 24)])
          (ui/gap-h 24)
          (m/Column
           .mainAxisSize m.MainAxisSize/min
           .children
           [(ui/text "Writing" {:size 13.0 :color (t/ink-muted)})
            (ui/gap-v 8)
            (setting-pills (:writing-mode settings)
                           [[:vertical "Vert"]
                            [:horizontal "Horiz"]]
                           #(store/update-settings! :writing-mode %))])
          (ui/gap-h 20)
          (m/Column
           .mainAxisSize m.MainAxisSize/min
           .children
           [(ui/text "Direction" {:size 13.0 :color (t/ink-muted)})
            (ui/gap-v 8)
            (setting-pills (:reading-direction settings)
                           [[:left-to-right "LTR"]
                            [:right-to-left "RTL"]]
                           #(store/update-settings! :reading-direction %))])
          (ui/gap-h 20)
          (m/Column
           .mainAxisSize m.MainAxisSize/min
           .children
           [(ui/text "Font" {:size 13.0 :color (t/ink-muted)})
            (ui/gap-v 8)
            (setting-pills (:font-family settings)
                           [["OyunQaganTig" "Oyun"]
                            ["MongolianBaiZheng" "BaiZheng"]]
                           #(store/update-settings! :font-family %))])
          (ui/gap-h 20)
          (m/Column
           .mainAxisSize m.MainAxisSize/min
           .children
           [(ui/text "Theme" {:size 13.0 :color (t/ink-muted)})
            (ui/gap-v 8)
            (setting-pills (:theme settings)
                           [[:light "Light"]
                            [:sepia "Sepia"]
                            [:dark "Dark"]
                            [:black "Black"]]
                           #(store/update-settings! :theme %))])])))]))))

;; Search result tile
(defn- hit-tile [hit]
  (mgl/MongolListTile
   .contentPadding (m/EdgeInsets.symmetric .horizontal 12.0 .vertical 10.0)
   .shape (m/RoundedRectangleBorder
           .borderRadius (m/BorderRadius.circular t/radius-m))
   .tileColor (t/surface)
   .title (ui/text (.-snippet hit) {:size 14.0 :max-lines 3})
   .onTap (fn [] (core/go-to-search-hit! hit))))

;; Search panel (right-side overlay)
(defn- search-panel [results]
  (ui/side-sheet
   :right t/side-panel-width
   (m/SafeArea
    .child
    (m/Column
     .children
     [(m/Padding
       .padding (m/EdgeInsets.fromLTRB 16.0 20.0 16.0 12.0)
       .child
       (m/Row
        .children
        [(t/mongol-label "ᠬᠠᠶᠢᠯᠲᠠ" {:size 20.0 :weight m.FontWeight/bold})
         (m/Spacer)
         (ui/icon-btn m.Icons/close_rounded
                      (fn [] (store/set-ui! :search-visible false))
                      :size 22.0)]))
      (ui/divider :margin (m/EdgeInsets.symmetric .horizontal 16.0))
      (m/Row
       .children
       [(m/SizedBox
         .width 80.0
         .child
         (m/Padding
          .padding (m/EdgeInsets.symmetric .horizontal 12.0 .vertical 16.0)
          .child
          (m/Container
           .padding (m/EdgeInsets.all 12.0)
           .decoration (m/BoxDecoration
                        .color (t/surface-2)
                        .borderRadius (m/BorderRadius.circular t/radius-m))
           .child
           (mgl/MongolTextField
            .decoration (m/InputDecoration
                         .hintText "Search..."
                         .border m/InputBorder.none
                         .hintStyle (t/mongol-style :size 15.0 :color (t/ink-faint)))
            .style (t/mongol-style :size 15.0)
            .onSubmitted (fn [q] (core/search! q))))))
        (m/Expanded
         .child
         (if (empty? results)
           (ui/empty-state m.Icons/search_off "No results"
                           :subtitle "Type to search")
           (m/ListView
            .scrollDirection m.Axis/horizontal
            .padding (m/EdgeInsets.symmetric .horizontal 12.0 .vertical 16.0)
            .children (vec (map hit-tile results)))))])]))))

;; Bookmark tile
(defn- bookmark-tile [bm]
  (mgl/MongolListTile
   .contentPadding (m/EdgeInsets.symmetric .horizontal 12.0 .vertical 10.0)
   .shape (m/RoundedRectangleBorder
           .borderRadius (m/BorderRadius.circular t/radius-m))
   .tileColor (t/surface)
   .title (ui/text (or (.-title bm) "Bookmark") {:size 15.0 :max-lines 1 :weight m.FontWeight/w500})
   .onTap (fn []
            (store/set-ui! :bookmarks-visible false)
            (core/go-to-position! (.-position bm)))
   .trailing
   (m/IconButton
    .icon (m/Icon m.Icons/delete_outline .color t/danger)
    .iconSize 20.0
    .onPressed (fn [] (core/remove-bookmark! (.-id bm))))))

;; Bookmarks panel (right-side overlay)
(defn- bookmarks-panel [bookmarks]
  (ui/side-sheet
   :right t/side-panel-width
   (m/SafeArea
    .child
    (m/Column
     .children
     [(m/Padding
       .padding (m/EdgeInsets.fromLTRB 16.0 20.0 16.0 12.0)
       .child
       (m/Row
        .children
        [(t/mongol-label "ᠳᠡᠮᠳᠡᠭ" {:size 20.0 :weight m.FontWeight/bold})
         (ui/gap-h 8)
         (ui/badge (str (count bookmarks)) :size 22.0)
         (m/Spacer)
         (ui/icon-btn m.Icons/close_rounded
                      (fn [] (store/set-ui! :bookmarks-visible false))
                      :size 22.0)]))
      (ui/divider :margin (m/EdgeInsets.symmetric .horizontal 16.0))
      (m/Expanded
       .child
       (if (empty? bookmarks)
         (ui/empty-state m.Icons/bookmarks_outlined "No bookmarks"
                         :subtitle "Double-tap a page to bookmark it")
         (m/ListView
          .scrollDirection m.Axis/horizontal
          .padding (m/EdgeInsets.symmetric .horizontal 12.0 .vertical 16.0)
          .children (vec (map bookmark-tile bookmarks)))))]))))

;; Annotation/note tile
(defn- note-tile [ann]
  (mgl/MongolListTile
   .contentPadding (m/EdgeInsets.symmetric .horizontal 12.0 .vertical 10.0)
   .shape (m/RoundedRectangleBorder
           .borderRadius (m/BorderRadius.circular t/radius-m))
   .tileColor (t/surface)
   .title (ui/text (or (.-note ann) "Note") {:size 14.0 :max-lines 3})
   .onTap (fn []
            (store/set-ui! :notes-visible false)
            (core/go-to-position! (.-start ann)))
   .trailing
   (m/IconButton
    .icon (m/Icon m.Icons/delete_outline .color t/danger)
    .iconSize 20.0
    .onPressed (fn [] (core/remove-annotation! (.-id ann))))))

;; Notes panel (right-side overlay)
(defn- notes-panel [annotations]
  (ui/side-sheet
   :right t/side-panel-width
   (m/SafeArea
    .child
    (m/Column
     .children
     [(m/Padding
       .padding (m/EdgeInsets.fromLTRB 16.0 20.0 16.0 12.0)
       .child
       (m/Row
        .children
        [(t/mongol-label "ᠲᠡᠮᠳᠡᠭᠯᠡᠯ" {:size 20.0 :weight m.FontWeight/bold})
         (ui/gap-h 8)
         (ui/badge (str (count annotations)) :size 22.0)
         (m/Spacer)
         (ui/icon-btn m.Icons/close_rounded
                      (fn [] (store/set-ui! :notes-visible false))
                      :size 22.0)]))
      (ui/divider :margin (m/EdgeInsets.symmetric .horizontal 16.0))
      (m/Expanded
       .child
       (if (empty? annotations)
         (ui/empty-state m.Icons/notes_outlined "No notes"
                         :subtitle "Select text to add a note")
         (m/ListView
          .scrollDirection m.Axis/horizontal
          .padding (m/EdgeInsets.symmetric .horizontal 12.0 .vertical 16.0)
          .children (vec (map note-tile annotations)))))]))))

;; Selection action button (icon + label, Mongolian vertical)
(defn- mongol-action [label icon on-pressed]
  (m/Container
   .margin (m/EdgeInsets.symmetric .horizontal 4.0)
   .child
   (m/Material
    .color (t/surface)
    .borderRadius (m/BorderRadius.circular t/radius-m)
    .child
    (m/InkWell
     .onTap on-pressed
     .borderRadius (m/BorderRadius.circular t/radius-m)
     .child
     (m/Padding
      .padding (m/EdgeInsets.symmetric .horizontal 12.0 .vertical 10.0)
      .child
      (m/Row
       .mainAxisSize m.MainAxisSize/min
       .children
       [(m/Icon icon .color t/primary .size 18.0)
        (ui/gap-h 6)
        (ui/text label {:size 13.0 :color t/primary :weight m.FontWeight/w500})]))))))

;; Floating selection toolbar
(defn- selection-toolbar []
  (m/Positioned
   .bottom 28.0 .left 20.0 .right 20.0
   .child
   (m/Material
    .elevation 10.0
    .color (t/surface)
    .shadowColor (t/fade (t/ink) 0.15)
    .borderRadius (m/BorderRadius.circular t/radius-l)
    .child
    (m/Padding
     .padding (m/EdgeInsets.symmetric .horizontal 10.0 .vertical 12.0)
     .child
     (m/SingleChildScrollView
      .scrollDirection m.Axis/horizontal
      .child
      (m/Row
       .mainAxisSize m.MainAxisSize/min
       .children
       [(mongol-action "Copy"      m.Icons/copy_rounded            (fn [] (core/copy-selection!)))
        (mongol-action "Highlight" m.Icons/highlight_rounded       (fn [] (core/add-highlight!)))
        (mongol-action "Underline" m.Icons/format_underline_rounded (fn [] (core/add-underline!)))
        (mongol-action "Note"      m.Icons/note_add_rounded        (fn [] (core/begin-note!)))
        (mongol-action "Search"    m.Icons/search_rounded          (fn [] (core/search-from-selection!)))
        (mongol-action "Share"     m.Icons/share_rounded           (fn [] (core/share-selection!)))]))))))

;; Note editor panel (floating card)
(defn- note-panel [draft]
  (m/Positioned
   .left 28.0 .right 28.0 .bottom 60.0 .height 300.0
   .child
   (m/Material
    .elevation 12.0
    .color (t/surface)
    .shadowColor (t/fade (t/ink) 0.2)
    .borderRadius (m/BorderRadius.circular t/radius-xl)
    .child
    (m/Padding
     .padding (m/EdgeInsets.all 20.0)
     .child
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/stretch
      .children
      [(t/mongol-label "ᠲᠡᠮᠳᠡᠭᠯᠡᠯ" {:size 18.0 :weight m.FontWeight/bold})
       (ui/gap-h 16)
       (m/Expanded
        .child
        (m/Container
         .padding (m/EdgeInsets.all 12.0)
         .decoration (m/BoxDecoration
                      .color (t/surface-2)
                      .borderRadius (m/BorderRadius.circular t/radius-m))
         .child
         (mgl/MongolTextField
          .maxLines nil
          .expands true
          .decoration (m/InputDecoration
                       .hintText "Write a note..."
                       .border m/InputBorder.none
                       .hintStyle (t/mongol-style :size 16.0 :color (t/ink-faint)))
          .style (t/mongol-style :size 16.0)
          .onChanged (fn [txt] (store/set-note-draft! txt)))))
       (ui/gap-h 12)
       (m/Column
        .mainAxisAlignment m.MainAxisAlignment/end
        .children
        [(m/ElevatedButton
          .onPressed (fn [] (core/save-note! draft))
          .style (m/ElevatedButton.styleFrom
                  .backgroundColor t/primary
                  .foregroundColor m.Colors/white
                  .padding (m/EdgeInsets.symmetric .horizontal 16.0 .vertical 12.0)
                  .shape (m/RoundedRectangleBorder
                          .borderRadius (m/BorderRadius.circular t/radius-m)))
          .child (ui/text "Save" {:color m.Colors/white :size 14.0 :weight m.FontWeight/w500}))
         (ui/gap-v 8)
         (m/TextButton
          .onPressed (fn [] (core/clear-selection!))
          .style (m/TextButton.styleFrom
                  .foregroundColor (t/ink-muted)
                  .padding (m/EdgeInsets.symmetric .horizontal 16.0 .vertical 12.0))
          .child (ui/text "Cancel" {:color (t/ink-muted) :size 14.0}))])])))))

;; Full overlay stack (chrome + panels)
(defn- overlay [state]
  (let [ui-state (:ui state)
        book (:book state)
        settings (:settings state)
        menu? (:menu-visible ui-state)]
    (m/Stack
     .children
     (filterv some?
              [(when menu? (left-bar book))
               (when (and menu? (seq (:pages state)))
                 (right-bar state))
               (when (:toc-visible ui-state)
                 (m/Positioned
                  .top 0.0 .bottom 0.0
                  .left (if menu? t/chrome-width 0.0)
                  .width t/toc-pane-width
                  .child
                  (ui/frosted
                   (m/SafeArea
                    .child
                    (m/Column
                     .children
                     [(m/Padding
                       .padding (m/EdgeInsets.fromLTRB 16.0 20.0 16.0 12.0)
                       .child
                       (m/Row
                        .children
                        [(t/mongol-label "ᠭᠠᠷᠴᠠᠭ" {:size 20.0 :weight m.FontWeight/bold})
                         (m/Spacer)
                         (ui/icon-btn m.Icons/close_rounded
                                      (fn [] (store/set-ui! :toc-visible false))
                                      :size 22.0)]))
                      (ui/divider :margin (m/EdgeInsets.symmetric .horizontal 16.0))
                      (m/Expanded
                       .child (toc-list (or (some-> book .-toc) [])))]))
                   :elevation 8.0 :opacity 0.92)))
               (when (:settings-visible ui-state) (settings-panel settings))
               (when (:search-visible ui-state) (search-panel (:search-results state)))
               (when (:bookmarks-visible ui-state) (bookmarks-panel (:bookmarks state)))
               (when (:notes-visible ui-state) (notes-panel (:annotations state)))
               (when (:selection state) (selection-toolbar))
               (when (:note-visible ui-state) (note-panel (:note-draft state)))]))))

;; Root reader screen
(defn screen []
  (f/widget
   :watch [state store/app-state]
   (m/Scaffold
    .backgroundColor (t/bg)
    .body
    (m/SafeArea
     .child
     (m/LayoutBuilder
      .builder
      (fn [_ constraints]
        (let [size (m/Size. (.-maxWidth constraints) (.-maxHeight constraints))]
          (page/schedule-paginate! state size)
          (m/GestureDetector
           .onTap (fn []
                    (store/set-highlight! nil)
                    (if (:selection state)
                      (core/clear-selection!)
                      (store/toggle-ui! :menu-visible)))
           .onDoubleTap (fn [] (core/add-bookmark!))
           .child
           (m/Stack
            .children
            [(page/view state size)
             (m/Positioned
              .top 0.0 .bottom 0.0 .right 0.0 .width 5.0
              .child (ui/v-progress (or (:progress state) 0.0)))
             (overlay state)
             (if (:error state)
               (ui/error-banner (:error state) store/clear-error!)
               (m/SizedBox.shrink))])))))))))
