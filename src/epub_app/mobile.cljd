(ns epub-app.mobile
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [epub-app.mobile.screens.library :as library]
            [epub-app.mobile.screens.reader :as reader]
            [epub-app.mobile.screens.search :as search]
            [epub-app.mobile.screens.settings :as settings]
            [epub-app.mobile.widgets.nav :as nav]
            [epub-app.services.epub-core :as core]
            [epub-app.state.store :as store]
            [epub-app.theme :as t]
            [virtual-keyboard.input-control :as input-control]))

(defn- tab-body [tab]
  (case tab
    :search (search/screen)
    :settings (settings/screen)
    (library/screen)))

(defn- opening? [state]
  (contains? #{:loading-book :loading-chapter} (:status state)))

(defn- shell [state kb-open?]
  (let [tab (or (:mobile-tab state) :library)]
    (m/Scaffold
     .backgroundColor t/bg
     .resizeToAvoidBottomInset false
     .appBar (when kb-open? (search/app-bar))
     .body
     (m/SafeArea
      .top (not kb-open?)
      .bottom false
      .child
      (m/Stack
       .fit m.StackFit/expand
       .children
       [(tab-body tab)
        (if (opening? state)
          (m/ModalBarrier
           .dismissible false
           .color (t/fade t/ink 0.18))
          (m/SizedBox.shrink))
        (if (opening? state)
          (m/Center .child (m/CircularProgressIndicator.))
          (m/SizedBox.shrink))]))
     .bottomNavigationBar (when-not kb-open? (nav/bar tab))
     .floatingActionButton
     (when (and (= tab :library) (not kb-open?))
       (m/FloatingActionButton
        .backgroundColor t/primary
        .foregroundColor m.Colors/white
        .onPressed (fn [] (core/pick-and-import!) nil)
        .child (m/Icon m.Icons/add))))))

(defn- root []
  (f/widget
   :watch [state store/app-state
           kb-open? input-control/visible]
   (if (:book state)
     (reader/screen)
     (shell state kb-open?))))

(defn app []
  (m/MaterialApp
   .title "MGL EPUB"
   .debugShowCheckedModeBanner false
   .theme t/app-theme
   .home (root)))
