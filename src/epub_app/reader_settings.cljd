(ns epub-app.reader-settings
  "Shared reader settings sections (mgl-components) for mobile and desktop."
  (:require ["package:flutter/gestures.dart" :as g]
            ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [components.setting :as setting]
            [epub-app.state.store :as store]))

(def ^:private writing-modes
  [[:vertical "vertical"]
   [:horizontal "horizontal"]])

(def ^:private reading-dirs
  [[:left-to-right "LTR"]
   [:right-to-left "RTL"]])

(def ^:private fonts
  [["OyunQaganTig" "Oyun"]
   ["MongolianBaiZheng" "BaiZheng"]])

(def ^:private themes
  [[:light "light"]
   [:sepia "sepia"]
   [:dark "dark"]
   [:black "black"]])

(def ^:private app-appearances
  [[:light "Light"]
   [:dark "Dark"]])

(defn- option-label [value options]
  (or (some (fn [[id label]] (when (= id value) label)) options)
      (str value)))

(defn- cycle-value [value options]
  (let [ids (mapv first options)
        n (count ids)
        idx (or (first (keep-indexed (fn [i id] (when (= id value) i)) ids)) -1)]
    (nth ids (mod (inc idx) n))))

(defn- clamp [v lo hi]
  (double (max lo (min hi v))))

(defn- step-btn [icon on-tap]
  (m/GestureDetector
   .onTap on-tap
   .behavior m.HitTestBehavior/opaque
   .child
   (m/SizedBox
    .width 24.0
    .height 24.0
    .child (m/Center .child (m/Icon icon .size 18.0)))))

(defn- stepper [on-dec on-inc]
  (m/FittedBox
   .fit m.BoxFit/scaleDown
   .child
   (m/Column
    .mainAxisSize m.MainAxisSize/min
    .children
    [(step-btn m.Icons/remove on-dec)
     (step-btn m.Icons/add on-inc)])))

(defn- ime-tap [ime-mode on-ime-mode-changed]
  (fn []
    (let [next (if (= ime-mode :system) :builtin :system)]
      (store/update-settings! :ime-mode next)
      (when on-ime-mode-changed (on-ime-mode-changed (= :builtin next)))
      nil)))

(defn sections
  [settings & {:keys [group-config on-ime-mode-changed]}]
  (let [{:keys [font-size line-height writing-mode reading-direction font-family
                theme app-appearance ime-mode]}
        settings
        group-opts (when group-config [:custom-config group-config])]
    [(apply setting/settings-section
            "Type"
            [{:title "Font size"
              :subtitle (.toStringAsFixed (double font-size) 0)
              :leading m.Icons/format_size
              :trailing (stepper
                         (fn []
                           (store/update-settings! :font-size (clamp (- font-size 1.0) 14.0 36.0))
                           nil)
                         (fn []
                           (store/update-settings! :font-size (clamp (+ font-size 1.0) 14.0 36.0))
                           nil))}
             {:title "Line height"
              :subtitle (.toStringAsFixed (double line-height) 1)
              :leading m.Icons/format_line_spacing
              :trailing (stepper
                         (fn []
                           (store/update-settings! :line-height (clamp (- line-height 0.1) 1.2 2.4))
                           nil)
                         (fn []
                           (store/update-settings! :line-height (clamp (+ line-height 0.1) 1.2 2.4))
                           nil))}
             {:title "Font"
              :subtitle (option-label font-family fonts)
              :leading m.Icons/font_download_outlined
              :show-arrow? true
              :on-tap (fn []
                        (store/update-settings! :font-family (cycle-value font-family fonts))
                        nil)}]
            group-opts)
     (apply setting/settings-section
            "Reading"
            [{:title "Writing mode"
              :subtitle (option-label writing-mode writing-modes)
              :leading m.Icons/view_agenda_outlined
              :show-arrow? true
              :on-tap (fn []
                        (store/update-settings! :writing-mode (cycle-value writing-mode writing-modes))
                        nil)}
             {:title "Direction"
              :subtitle (option-label reading-direction reading-dirs)
              :leading m.Icons/swap_horiz
              :show-arrow? true
              :on-tap (fn []
                        (store/update-settings! :reading-direction (cycle-value reading-direction reading-dirs))
                        nil)}]
            group-opts)
     (apply setting/settings-section
            "Theme"
            [{:title "App appearance"
              :subtitle (option-label (or app-appearance :light) app-appearances)
              :leading m.Icons/brightness_6_outlined
              :show-arrow? true
              :on-tap (fn []
                        (store/update-settings! :app-appearance
                                                (cycle-value (or app-appearance :light) app-appearances))
                        nil)}
             {:title "Reading theme"
              :subtitle (option-label theme themes)
              :leading m.Icons/palette_outlined
              :show-arrow? true
              :on-tap (fn []
                        (store/update-settings! :theme (cycle-value theme themes))
                        nil)}]
            group-opts)
     (apply setting/settings-section
            "Input"
            [{:title "Input method"
              :subtitle (if (= ime-mode :system) "System" "Built-in")
              :leading m.Icons/keyboard_outlined
              :show-arrow? true
              :on-tap (ime-tap ime-mode on-ime-mode-changed)}]
            group-opts)]))

(defn- scroll-by-wheel! [^m/ScrollController ctrl delta]
  (when (and (.-hasClients ctrl) (not= delta 0.0))
    (let [pos (.-position ctrl)]
      (.jumpTo ctrl
               (-> (+ (.-pixels pos) delta)
                   (max 0.0)
                   (min (.-maxScrollExtent pos))))))
  nil)

(defn- wheel-to-horizontal [ctrl child]
  (m/Listener
   .onPointerSignal
   (fn [event]
     (when (instance? g/PointerScrollEvent event)
       (let [d (.-scrollDelta ^g/PointerScrollEvent event)]
         (scroll-by-wheel! ctrl (+ (.-dx d) (.-dy d)))))
     nil)
   .child child))

(defn horizontal-list
  [settings & {:keys [group-config on-ime-mode-changed wheel-horizontal?]}]
  (let [content (fn [ctrl]
                  (m/ListView
                   .controller ctrl
                   .scrollDirection m.Axis/horizontal
                   .physics (m/ClampingScrollPhysics.)
                   .padding (m.EdgeInsets/symmetric .vertical 8.0)
                   .children (vec (sections settings
                                            :group-config group-config
                                            :on-ime-mode-changed on-ime-mode-changed))))]
    (if wheel-horizontal?
      (f/widget
       :managed [ctrl (m/ScrollController.)]
       (wheel-to-horizontal ctrl (content ctrl)))
      (content nil))))
