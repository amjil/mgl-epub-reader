(ns epub-app.state.store
  (:require             ["package:shared_preferences/shared_preferences.dart" :as sp]
            [epub-app.theme :as theme]))

(def ^:private pref-font "reader_font_size")
(def ^:private pref-height "reader_line_height")
(def ^:private pref-theme "reader_theme")
(def ^:private pref-app-appearance "app_appearance")
(def ^:private pref-mode "reader_writing_mode")
(def ^:private pref-dir "reader_reading_direction")
(def ^:private pref-family "reader_font_family")
(def ^:private pref-ime "reader_ime_mode")
(def ^:private pref-margin "reader_margin")
(defn- book-pref [book-id]
  (str "book_reader_settings_" book-id))

(defn- settings-text [settings]
  (str "font-size=" (double (:font-size settings)) "\n"
       "line-height=" (double (:line-height settings)) "\n"
       "margin=" (double (or (:margin settings) 28.0)) "\n"
       "writing-mode=" (name (:writing-mode settings)) "\n"
       "reading-direction=" (name (:reading-direction settings)) "\n"
       "font-family=" (or (:font-family settings) "OyunQaganTig") "\n"
       "theme=" (name (:theme settings)) "\n"))

(defn- parse-settings [raw]
  (into {}
        (keep (fn [line]
                (let [i (.indexOf line "=")]
                  (when (pos? i)
                    [(.substring line 0 i) (.substring line (inc i))])))
              (.split (or raw "") "\n"))))

(defonce app-state
  (atom
   {:status :idle
    :library []
    :shelves []
    :library-filter :all
    :library-search-query ""
    :mobile-tab :library
    :book nil
    :library-book nil
    :chapter nil
    :pages []
    :page 0
    :position nil
    :pending-position nil
    :landing :first
    :selection nil
    :note-draft ""
    :bookmarks []
    :annotations []
    :search-query ""
    :search-results []
    :search-hit-index -1
    :search-busy false
    :jump-fraction nil
    :highlight nil
    :progress 0.0
    :paginate-gen 0
    :viewport-key nil
    :settings {:font-size 22.0
               :line-height 1.8
               :theme :light
               :app-appearance :light
               :writing-mode :vertical
               :reading-direction :left-to-right
               :font-family "OyunQaganTig"
               :margin 28.0
               :embedded-fonts []
               :ime-mode :builtin}
    :ui {:menu-visible false
         :toc-visible false
         :settings-visible false
         :search-visible false
         :bookmarks-visible false
         :notes-visible false
         :note-visible false
         :library-filter-visible false}
    :toc-pane-width 240.0
    :link-preview nil
    :error nil}))

(defn- persist-settings! [settings]
  (-> (.getInstance sp/SharedPreferences)
      (.then (fn [prefs]
               (.setDouble prefs pref-font (:font-size settings))
               (.setDouble prefs pref-height (:line-height settings))
               (.setString prefs pref-theme (name (:theme settings)))
               (.setString prefs pref-app-appearance (name (:app-appearance settings)))
               (.setString prefs pref-mode (name (:writing-mode settings)))
               (.setString prefs pref-dir (name (:reading-direction settings)))
               (.setString prefs pref-family (:font-family settings))
               (.setDouble prefs pref-margin (double (or (:margin settings) 28.0)))
               (.setString prefs pref-ime (name (:ime-mode settings)))
               (when-let [book (:library-book @app-state)]
                 (.setString prefs (book-pref (.-id book))
                             (settings-text settings)))))
      (.catchError (fn [e]
                     (dart:core/print (str "settings write failed: " e))
                     nil)))
  nil)

(defn- read-num [m k fallback]
  (let [v (get m k)
        n (when (and v (seq (str v)))
            (.tryParse dart:core/double (str v)))]
    (if (nil? n) fallback n)))

(defn- read-name [m k fallback]
  (let [v (get m k)]
    (if (or (nil? v) (= "" v)) fallback (keyword v))))

(defn merge-book-settings! [saved]
  (when (seq saved)
    (swap! app-state
           (fn [s]
             (-> s
                 (update :settings
                         (fn [cur]
                           (assoc cur
                                  :font-size (read-num saved "font-size" (:font-size cur))
                                  :line-height (read-num saved "line-height" (:line-height cur))
                                  :margin (read-num saved "margin" (or (:margin cur) 28.0))
                                  :writing-mode (read-name saved "writing-mode" (:writing-mode cur))
                                  :reading-direction (read-name saved "reading-direction"
                                                                (:reading-direction cur))
                                  :font-family (or (get saved "font-family") (:font-family cur))
                                  :theme (read-name saved "theme" (:theme cur)))))
                 (update :paginate-gen (fnil inc 0))
                 (assoc :pages [] :page 0 :viewport-key nil)))))
  nil)

(defn apply-book-settings! [book-id]
  (-> (.getInstance sp/SharedPreferences)
      (.then (fn [prefs]
               (let [raw (.getString prefs (book-pref book-id))]
                 (when (and raw (seq raw))
                   (merge-book-settings! (parse-settings raw))))))
      (.catchError (fn [e]
                     (dart:core/print (str "book settings read failed: " e))
                     nil))))

(defn set-embedded-fonts! [names]
  (swap! app-state assoc-in [:settings :embedded-fonts] (vec (or names []))))

(defn load-prefs! []
  (-> (.getInstance sp/SharedPreferences)
      (.then (fn [prefs]
               (swap! app-state update :settings
                      (fn [s]
                        (cond-> s
                          (.containsKey prefs pref-font)
                          (assoc :font-size (.getDouble prefs pref-font))
                          (.containsKey prefs pref-height)
                          (assoc :line-height (.getDouble prefs pref-height))
                          (.containsKey prefs pref-theme)
                          (assoc :theme (keyword (.getString prefs pref-theme)))
                          (.containsKey prefs pref-app-appearance)
                          (assoc :app-appearance (keyword (.getString prefs pref-app-appearance)))
                          (.containsKey prefs pref-mode)
                          (assoc :writing-mode (keyword (.getString prefs pref-mode)))
                          (.containsKey prefs pref-dir)
                          (assoc :reading-direction (keyword (.getString prefs pref-dir)))
                          (.containsKey prefs pref-family)
                          (assoc :font-family (.getString prefs pref-family))
                          (.containsKey prefs pref-margin)
                          (assoc :margin (.getDouble prefs pref-margin))
                          (.containsKey prefs pref-ime)
                          (assoc :ime-mode (keyword (.getString prefs pref-ime))))))
               (theme/apply-appearance!
                (get-in @app-state [:settings :app-appearance] :light))))
      (.catchError (fn [e]
                     (dart:core/print (str "load prefs failed: " e))
                     nil))))

(defn set-library! [books]
  (swap! app-state assoc :library (vec (or books [])) :error nil))

(defn set-shelves! [shelves]
  (swap! app-state assoc :shelves (vec (or shelves []))))

(defn set-library-filter! [f]
  (swap! app-state assoc :library-filter f))

(defn set-mobile-tab! [tab]
  (swap! app-state assoc :mobile-tab tab))

(defn set-library-search! [q]
  (swap! app-state assoc :library-search-query (or q "")))

(defn set-error! [msg]
  (swap! app-state (fn [s]
                     (assoc s :error msg :status (if msg :error (:status s))))))

(defn set-notice! [msg]
  (swap! app-state assoc :error msg))

(defn clear-error! []
  (swap! app-state assoc :error nil))

(defn set-status! [status]
  (swap! app-state assoc :status status))

(defn set-open-book! [library-book book]
  (swap! app-state (fn [s]
                     (-> s
                         (update :paginate-gen (fnil inc 0))
                         (assoc
                          :library-book library-book
                          :book book
                          :chapter nil
                          :pages []
                          :page 0
                          :position nil
                          :pending-position nil
                          :selection nil
                          :note-draft ""
                          :highlight nil
                          :progress (or (some-> library-book .-progress) 0.0)
                          :viewport-key nil
                          :link-preview nil
                          :status :book-loaded)))))

(defn set-landing! [landing]
  (swap! app-state assoc :landing landing))

(defn set-pending-position! [position]
  (swap! app-state assoc :pending-position position))

(defn set-chapter! [chapter]
  (swap! app-state (fn [s]
                     (-> s
                         (update :paginate-gen (fnil inc 0))
                         (assoc :chapter chapter
                                :pages []
                                :page 0
                                :viewport-key nil
                                :status :loading-chapter)))))

(defn set-pages! [pages page]
  (let [n (count (or pages []))
        idx (cond
              (or (nil? page) (neg? page)) 0
              (and (pos? n) (>= page n)) (dec n)
              :else (or page 0))]
    (swap! app-state assoc :pages (vec (or pages [])) :page idx :status :ready)))

(defn begin-paginate! [viewport-key]
  (:paginate-gen
   (swap! app-state (fn [s]
                      (let [resize? (not= (:viewport-key s) viewport-key)]
                        (-> s
                            (update :paginate-gen (fnil inc 0))
                            (assoc :status :paginating
                                   :viewport-key viewport-key
                                   :error nil)
                            (cond-> resize?
                              (assoc :pages [] :page 0))))))))

(defn paginate-matches? [gen chapter-id]
  (let [s @app-state]
    (and (= gen (:paginate-gen s))
         (= chapter-id (some-> (:chapter s) .-id)))))

(defn set-page! [page]
  (swap! app-state assoc :page page))

(defn set-position! [position]
  (swap! app-state assoc :position position))

(defn set-progress! [progress]
  (swap! app-state assoc :progress (or progress 0.0)))

(defn set-highlight! [highlight]
  (swap! app-state assoc :highlight highlight))

(defn set-selection! [selection]
  (swap! app-state assoc :selection selection))

(defn set-note-draft! [text]
  (swap! app-state assoc :note-draft (or text "")))

(def ^:private layout-setting-keys
  #{:font-size :line-height :writing-mode :reading-direction :font-family :margin})

(defn update-settings! [k v]
  (when (= k :app-appearance)
    (theme/apply-appearance! v))
  (swap! app-state (fn [s]
                     (let [next (assoc-in s [:settings k] v)]
                       (if (contains? layout-setting-keys k)
                         (-> next
                             (update :paginate-gen (fnil inc 0))
                             (assoc :pages [] :page 0 :viewport-key nil))
                         next))))
  (persist-settings! (:settings @app-state)))

(defn toggle-ui! [k]
  (swap! app-state update-in [:ui k] not))

(defn set-ui! [k v]
  (swap! app-state assoc-in [:ui k] v))

(def ^:private right-panel-keys
  [:settings-visible :search-visible :bookmarks-visible :notes-visible])

(def ^:private mobile-panel-keys
  [:toc-visible :settings-visible :search-visible :bookmarks-visible :notes-visible])

(defn toggle-mobile-panel!
  "Mobile reader: TOC and side panels are mutually exclusive."
  [k]
  (swap! app-state update :ui
         (fn [ui]
           (let [on? (not (get ui k))]
             (reduce (fn [u key]
                       (assoc u key (and on? (= key k))))
                     ui
                     mobile-panel-keys)))))

(defn toggle-panel!
  "Desktop: TOC toggles independently; right-side panels are exclusive."
  [k]
  (swap! app-state update :ui
         (fn [ui]
           (let [on? (not (get ui k))]
             (if (= k :toc-visible)
               (assoc ui :toc-visible on?)
               (reduce (fn [u key]
                         (assoc u key (and on? (= key k))))
                       ui
                       right-panel-keys))))))

(defn show-panel! [k]
  (swap! app-state update :ui
         (fn [ui]
           (if (= k :toc-visible)
             (assoc ui :toc-visible true)
             (reduce (fn [u key]
                       (assoc u key (= key k)))
                     ui
                     right-panel-keys)))))

(defn hide-panels! []
  (swap! app-state update :ui assoc
         :toc-visible false
         :settings-visible false
         :search-visible false
         :bookmarks-visible false
         :notes-visible false))

(defn set-toc-pane-width! [w]
  (swap! app-state assoc :toc-pane-width (double w)))

(defn set-link-preview! [preview]
  (swap! app-state assoc :link-preview preview))

(defn clear-link-preview! []
  (swap! app-state assoc :link-preview nil))

(defn hide-chrome! []
  (swap! app-state assoc :ui {:menu-visible false
                              :toc-visible false
                              :settings-visible false
                              :search-visible false
                              :bookmarks-visible false
                              :notes-visible false
                              :note-visible false
                              :library-filter-visible false}))

(defn close-book! []
  (swap! app-state (fn [s]
                     (-> s
                         (update :paginate-gen (fnil inc 0))
                         (assoc
                          :book nil
                          :library-book nil
                          :chapter nil
                          :pages []
                          :page 0
                          :position nil
                          :pending-position nil
                          :selection nil
                          :note-draft ""
                          :bookmarks []
                          :annotations []
                          :search-query ""
                          :search-results []
                          :search-hit-index -1
                          :jump-fraction nil
                          :highlight nil
                          :progress 0.0
                          :viewport-key nil
                          :link-preview nil
                          :status :idle)
                         (assoc-in [:settings :embedded-fonts] []))))
  (hide-chrome!))

(defn set-search! [query results]
  (swap! app-state assoc
         :search-query query
         :search-results (vec (or results []))
         :search-hit-index -1))

(defn set-search-results! [results]
  (swap! app-state assoc :search-results (vec (or results []))))

(defn set-search-hit-index! [idx]
  (swap! app-state assoc :search-hit-index idx))

(defn set-search-busy! [busy?]
  (swap! app-state assoc :search-busy (boolean busy?)))

(defn set-jump-fraction! [fraction]
  (swap! app-state assoc :jump-fraction fraction))

(defn set-bookmarks! [items]
  (swap! app-state assoc :bookmarks (vec (or items []))))

(defn set-annotations! [items]
  (swap! app-state assoc :annotations (vec (or items []))))
