(ns epub-app.mobile.screens.search
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [cljd.flutter :as f]
            [epub-app.mobile.widgets.keyboard :as kb]
            [epub-app.state.store :as store]
            [epub-app.theme :as t]
            [epub-app.widgets.books :as books]
            [epub-app.widgets.ui :as ui]))

(defn- matches [state query]
  (filterv #(books/matches-query? % query) (:library state)))

(defn- dismiss-keyboard! []
  (kb/dismiss!)
  nil)

(defn app-bar []
  (m/AppBar
   .elevation 0.0
   .scrolledUnderElevation 0.0
   .backgroundColor (t/bg)
   .foregroundColor (t/ink)
   .surfaceTintColor m.Colors/transparent
   .automaticallyImplyLeading false
   .title nil
   .leading (m/IconButton
             .icon (m/Icon m.Icons/arrow_back)
             .tooltip "Back"
             .onPressed dismiss-keyboard!)))

(defn- search-field [search-ctrl search-focus-node query hit-count]
  (m/Container
   .width 68.0
   .margin (m/EdgeInsets.symmetric .horizontal 10.0 .vertical 16.0)
   .padding (m/EdgeInsets.fromLTRB 6.0 12.0 6.0 6.0)
   .decoration (m/BoxDecoration
                .color (t/surface)
                .borderRadius (m/BorderRadius.circular t/radius-m)
                .border (m/Border.all .color (t/outline) .width 1.0)
                .boxShadow (t/card-shadow))
   .child
   (m/Column
    .children
    [(m/Icon m.Icons/search .size 20.0 .color (t/ink-muted))
     (m/SizedBox .height 8.0)
     (m/Expanded
      .child
      (mgl/MongolTextField
       .controller search-ctrl
       .focusNode search-focus-node
       .maxLines 1
       .style (t/mongol-style :size 16.0)
       .decoration (m/InputDecoration
                    .hintText "Search"
                    .border m.InputBorder/none
                    .hintStyle (t/mongol-style :size 16.0 :color (t/ink-faint)))
       .onChanged (fn [txt] (store/set-library-search! (or txt "")) nil)
       .onSubmitted (fn [_]
                      (kb/dismiss!)
                      nil)))
     (if (seq query)
       (m/Column
        .mainAxisSize m.MainAxisSize/min
        .children
        [(ui/text (str hit-count)
                  {:size 12.0 :color (t/ink-muted) :weight m.FontWeight/w500})
         (m/IconButton
          .iconSize 18.0
          .visualDensity m.VisualDensity/compact
          .icon (m/Icon m.Icons/cancel_rounded .color (t/ink-muted))
          .onPressed (fn []
                       (.clear search-ctrl)
                       (store/set-library-search! "")
                       nil))])
       (m/SizedBox.shrink))])))

(defn screen []
  (f/widget
   :context ctx
   :managed [search-ctrl (m/TextEditingController.)
             search-focus-node (m/FocusNode)]
   :watch [state store/app-state]
   :bg-watcher ([^m/TextEditingValue {v .-text} search-ctrl]
                (store/set-library-search! (or v "")))
   (let [q (or (:library-search-query state) "")
         hits (matches state q)]
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/stretch
      .children
      [(search-field search-ctrl search-focus-node q (count hits))
       (m/Expanded
        .child
        (cond
          (empty? q)
          (m/GestureDetector
           .behavior m.HitTestBehavior/opaque
           .onTap dismiss-keyboard!
           .child (ui/empty-state m.Icons/search "Search the library"))
          (empty? hits)
          (m/GestureDetector
           .behavior m.HitTestBehavior/opaque
           .onTap dismiss-keyboard!
           .child (ui/empty-state m.Icons/search_off "No matching books"))
          :else
          (m/ListView
           .scrollDirection m.Axis/horizontal
           .padding (m/EdgeInsets.fromLTRB 12.0 8.0 20.0 8.0)
           .children (vec (map #(books/library-card ctx %) hits)))))]))))
