(ns epub-app.mobile.screens.library
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [epub-app.state.store :as store]
            [epub-app.theme :as t]
            [epub-app.widgets.books :as books]
            [epub-app.widgets.ui :as ui]))

(defn- filter-strip [state]
  (m/Container
   .width 64.0
   .decoration (m/BoxDecoration
                .color t/surface
                .border (m/Border .right (m/BorderSide .color t/outline .width 1.0)))
   .child
   (m/SingleChildScrollView
    .padding (m.EdgeInsets/symmetric .horizontal 6.0 .vertical 8.0)
    .child (books/filter-rail (:library-filter state)))))

(defn- empty-library [state]
  (m/Center
   .child
   (m/Row
    .mainAxisSize m.MainAxisSize/min
    .children
    [(m/Icon m.Icons/menu_book_outlined .size 48.0 .color t/ink-muted)
     (ui/gap-h 16)
     (ui/text "EPUB" {:size 18.0 :color t/ink-muted})
     (if (:error state)
       (m/Padding
        .padding (m.EdgeInsets/only .left 16.0)
        .child (ui/text (:error state) {:color t/danger}))
       (m/SizedBox.shrink))])))

(defn- books-pane [state ctx]
  (cond
    (empty? (:library state))
    (empty-library state)

    (empty? (books/filtered-books state))
    (ui/empty-state m.Icons/filter_none "No books in this filter")

    :else
    (m/SingleChildScrollView
     .scrollDirection m.Axis/horizontal
     .padding (m.EdgeInsets/fromLTRB 16.0 16.0 24.0 16.0)
     .child
     (m/Wrap
      .direction m.Axis/vertical
      .spacing 16.0
      .runSpacing 20.0
      .children (vec (map #(books/library-card ctx %
                                               :margin (m.EdgeInsets/zero))
                          (books/filtered-books state)))))))

(defn screen []
  (f/widget
   :watch [state store/app-state]
   :context ctx
   (m/Row
    .crossAxisAlignment m.CrossAxisAlignment/stretch
    .children
    [(filter-strip state)
     (m/Expanded
      .child
      (m/Stack
       .fit m.StackFit/expand
       .children
       [(books-pane state ctx)
        (if (:error state)
          (ui/error-banner (:error state) store/clear-error!)
          (m/SizedBox.shrink))]))])))
