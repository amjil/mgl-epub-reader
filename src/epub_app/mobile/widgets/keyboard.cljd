(ns epub-app.mobile.widgets.keyboard
  "Mobile Mongolian virtual keyboard: IME install, candidates, bottom bar."
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [virtual-keyboard.input-control :as input-control]
            [virtual-keyboard.keyboard :as vk]
            [virtual-keyboard.keyboard-state :as kb-state]
            [virtual-keyboard.options :as vk-options]
            [epub-app.theme :as t]))

(def info
  (merge vk-options/keyboard-option
         {:keyboard/mongol-font-family "OyunQaganTig"
          :keyboard/key-container-color t/surface-2
          :keyboard/font-size 16}))

(defn dismiss! []
  (when-let [focus (.-primaryFocus m/FocusManager.instance)]
    (.unfocus focus))
  (.-value! input-control/visible false)
  nil)

(defn install []
  (input-control/set-control)
  (swap! kb-state/state assoc
         :keyboard/return-mode :single-line
         :keyboard/return-callback dismiss!)
  true)

(defn candidates []
  (vk/candidates nil))

(defn bar []
  (vk/keyboard {:custom-fns {:on-return dismiss!}}))

(defn wrap
  "Wrap main content with the in-app Mongolian virtual keyboard."
  [main-content]
  (swap! kb-state/state assoc
         :keyboard/return-mode :single-line
         :keyboard/return-callback dismiss!)
  (f/widget
   :let [kb-info info]
   :bind {:info kb-info}
   (m/SafeArea
    .top false
    .child
    (m/Column
     .children
     [(m/Expanded
       .child
       (m/Stack
        .children
        [main-content
         (candidates)]))
      (bar)]))))
