(ns epub-app.desktop.widgets.panels
  "Docked right-side panels and floating selection / note chrome."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [epub-app.services.epub-core :as core]
            [epub-app.state.store :as store]
            [epub-app.theme :as t]
            [epub-app.widgets.ui :as ui]))

(defn- setting-pills [value options on-pick]
  (m/Column
   .mainAxisSize m.MainAxisSize/min
   .children
   (mapv (fn [[id label]]
           (ui/pill {:label label
                     :active? (= id value)
                     :on-tap #(on-pick id)}))
         options)))

(defn- settings-body [settings]
  (m/SingleChildScrollView
   .scrollDirection m.Axis/horizontal
   .padding (m.EdgeInsets/all 16.0)
   .child
   (m/Row
    .crossAxisAlignment m.CrossAxisAlignment/center
    .children
    [(ui/text "Font size" {:size 13.0 :color t/ink-muted})
     (ui/gap-h 8)
     (ui/v-slider 14.0 36.0 (:font-size settings)
                  (fn [v] (store/update-settings! :font-size v)))
     (ui/gap-h 16)
     (ui/text "Line height" {:size 13.0 :color t/ink-muted})
     (ui/gap-h 8)
     (ui/v-slider 1.2 2.4 (:line-height settings)
                  (fn [v] (store/update-settings! :line-height v)))
     (ui/gap-h 16)
     (setting-pills (:writing-mode settings)
                    [[:vertical "vertical"]
                     [:horizontal "horizontal"]]
                    #(store/update-settings! :writing-mode %))
     (ui/gap-h 12)
     (setting-pills (:reading-direction settings)
                    [[:left-to-right "LTR"]
                     [:right-to-left "RTL"]]
                    #(store/update-settings! :reading-direction %))
     (ui/gap-h 12)
     (setting-pills (:font-family settings)
                    [["OyunQaganTig" "Oyun"]
                     ["MongolianBaiZheng" "BaiZheng"]]
                    #(store/update-settings! :font-family %))
     (ui/gap-h 12)
     (setting-pills (:theme settings)
                    [[:light "light"]
                     [:sepia "sepia"]
                     [:dark "dark"]
                     [:black "black"]]
                    #(store/update-settings! :theme %))])))

(defn- hit-tile [hit]
  (mgl/MongolListTile
   .title (ui/text (.-snippet hit) {:size 14.0 :max-lines 2})
   .onTap (fn [] (core/go-to-search-hit! hit))))

(defn- search-body [results]
  (m/Row
   .children
   [(m/SizedBox
     .width 72.0
     .child
     (m/Padding
      .padding (m.EdgeInsets/symmetric .horizontal 10.0 .vertical 12.0)
      .child
      (mgl/MongolTextField
       .autofocus true
       .decoration (m/InputDecoration
                    .hintText "Search"
                    .border m.InputBorder/none
                    .hintStyle (t/mongol-style :size 16.0 :color t/ink-faint))
       .style (t/mongol-style :size 16.0)
       .onSubmitted (fn [q] (core/search! q)))))
    (m/Expanded
     .child
     (m/ListView
      .scrollDirection m.Axis/horizontal
      .padding (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 12.0)
      .children (vec (map hit-tile results))))]))

(defn- bookmark-tile [bm]
  (mgl/MongolListTile
   .title (ui/text (or (.-title bm) "Bookmark") {:size 15.0 :max-lines 1})
   .onTap (fn []
            (store/set-ui! :bookmarks-visible false)
            (core/go-to-position! (.-position bm)))
   .trailing
   (m/IconButton
    .tooltip "Remove bookmark"
    .icon (m/Icon m.Icons/delete_outline .color t/danger)
    .onPressed (fn [] (core/remove-bookmark! (.-id bm))))))

(defn- bookmarks-body [bookmarks]
  (m/Row
   .children
   [(m/Padding
     .padding (m.EdgeInsets/fromLTRB 12.0 16.0 8.0 16.0)
     .child (ui/text "Bookmarks" {:size 16.0 :weight m.FontWeight/bold}))
    (m/Expanded
     .child
     (if (empty? bookmarks)
       (ui/empty-state m.Icons/bookmarks_outlined "No bookmarks")
       (m/ListView
        .scrollDirection m.Axis/horizontal
        .padding (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 12.0)
        .children (vec (map bookmark-tile bookmarks)))))]))

(defn- note-tile [ann]
  (mgl/MongolListTile
   .title (ui/text (or (.-note ann) "Note") {:size 15.0 :max-lines 2})
   .onTap (fn []
            (store/set-ui! :notes-visible false)
            (core/go-to-position! (.-start ann)))
   .trailing
   (m/IconButton
    .tooltip "Remove note"
    .icon (m/Icon m.Icons/delete_outline .color t/danger)
    .onPressed (fn [] (core/remove-annotation! (.-id ann))))))

(defn- notes-body [annotations]
  (m/Row
   .children
   [(m/Padding
     .padding (m.EdgeInsets/fromLTRB 12.0 16.0 8.0 16.0)
     .child (ui/text "Notes" {:size 16.0 :weight m.FontWeight/bold}))
    (m/Expanded
     .child
     (if (empty? annotations)
       (ui/empty-state m.Icons/notes_outlined "No notes")
       (m/ListView
        .scrollDirection m.Axis/horizontal
        .padding (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 12.0)
        .children (vec (map note-tile annotations)))))]))

(defn docked
  "Right-side docked pane. Returns nil when no right panel is open."
  [state]
  (let [ui-state (:ui state)
        child (cond
                (:search-visible ui-state) (search-body (:search-results state))
                (:bookmarks-visible ui-state) (bookmarks-body (:bookmarks state))
                (:notes-visible ui-state) (notes-body (:annotations state))
                (:settings-visible ui-state) (settings-body (:settings state))
                :else nil)]
    (when child
      (m/Container
       .width t/side-panel-width
       .decoration (m/BoxDecoration
                    .color t/surface
                    .border (m/Border .left (m/BorderSide .color t/outline .width 1.0)))
       .child child))))

(defn- mongol-action [label on-pressed]
  (mgl/MongolTextButton
   .onPressed on-pressed
   .child (ui/text label {:size 13.0 :color t/primary})))

(defn selection-toolbar []
  (m/Positioned
   .bottom 24.0 .left 16.0 .right 16.0
   .child
   (m/Material
    .elevation 8.0
    .color t/surface
    .borderRadius (m.BorderRadius/circular 12.0)
    .child
    (m/Padding
     .padding (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 8.0)
     .child
     (m/SingleChildScrollView
      .scrollDirection m.Axis/horizontal
      .child
      (m/Row
       .mainAxisSize m.MainAxisSize/min
       .children
       [(mongol-action "Copy" (fn [] (core/copy-selection!)))
        (mongol-action "Highlight" (fn [] (core/add-highlight!)))
        (mongol-action "Underline" (fn [] (core/add-underline!)))
        (mongol-action "Note" (fn [] (core/begin-note!)))
        (mongol-action "Search" (fn [] (core/search-from-selection!)))
        (mongol-action "Share" (fn [] (core/share-selection!)))]))))))

(defn note-editor [draft]
  (m/Positioned
   .left 24.0 .right 24.0 .bottom 48.0 .height 260.0
   .child
   (m/Material
    .elevation 10.0
    .color t/surface
    .borderRadius (m.BorderRadius/circular 12.0)
    .child
    (m/Padding
     .padding (m.EdgeInsets/all 16.0)
     .child
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/stretch
      .children
      [(ui/text "Note" {:size 16.0 :weight m.FontWeight/bold})
       (ui/gap-h 12)
       (m/Expanded
        .child
        (mgl/MongolTextField
         .maxLines nil
         .expands true
         .decoration (m/InputDecoration
                      .hintText "Write a note"
                      .border m.InputBorder/none
                      .hintStyle (t/mongol-style :size 16.0 :color t/ink-faint))
         .style (t/mongol-style :size 16.0)
         .onChanged (fn [txt] (store/set-note-draft! txt))
         .onSubmitted (fn [txt] (core/save-note! txt))))
       (ui/gap-h 8)
       (m/Column
        .mainAxisAlignment m.MainAxisAlignment/end
        .children
        [(mongol-action "Cancel" (fn [] (core/clear-selection!)))
         (mongol-action "Save" (fn [] (core/save-note! draft)))])])))))
