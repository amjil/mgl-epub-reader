(ns epub-app.desktop.widgets.panels
  "Reader overlays: search, contents, bookmarks, notes, settings."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [cljd.flutter :as f]
            [epub-app.desktop.widgets.toc :as toc]
            [epub-app.reader-settings :as rs]
            [epub-app.services.epub-core :as core]
            [epub-app.state.store :as store]
            [epub-app.theme :as t]
            [epub-app.widgets.ui :as ui]))

(def ^:private desktop-group-config
  {:min-item-width 120.0
   :max-item-width 150.0
   :card-radius 12.0
   :show-shadow false})

(def ^:private card-max-width 520.0)
(def ^:private card-max-height 560.0)

(defn- settings-body [settings]
  (rs/horizontal-list settings
                      :group-config desktop-group-config
                      :wheel-horizontal? true))

(defn- hit-tile [idx hit]
  (mgl/MongolListTile
   .title (ui/text (.-snippet hit) {:size 13.0 :max-lines 2})
   .onTap (fn [] (core/go-to-search-hit! hit idx) nil)))

(defn- search-body [state]
  (let [results (:search-results state)
        n (count results)
        idx (or (:search-hit-index state) -1)]
    (m/Row
     .children
     [(m/SizedBox
       .width 88.0
       .child
       (m/Padding
        .padding (m/EdgeInsets.symmetric .horizontal 8.0 .vertical 10.0)
        .child
        (m/Column
         .children
         [(m/Expanded
           .child
           (mgl/MongolTextField
            .autofocus true
            .decoration (m/InputDecoration
                         .hintText "Search"
                         .border m.InputBorder/none
                         .hintStyle (t/mongol-style :size 13.0 :color (t/ink-faint)))
            .style (t/mongol-style :size 13.0)
            .onSubmitted (fn [q] (core/search! q) nil)))
          (ui/text (if (pos? n)
                     (str (if (neg? idx) 0 (inc idx)) " / " n)
                     "")
                   {:size 12.0 :color (t/ink-muted)})
          (m/Row
           .mainAxisSize m.MainAxisSize/min
           .children
           [(ui/icon-btn m.Icons/chevron_left
                         (fn [] (core/step-search! -1))
                         :tooltip "Previous match"
                         :size 18.0)
            (ui/icon-btn m.Icons/chevron_right
                         (fn [] (core/step-search! 1))
                         :tooltip "Next match"
                         :size 18.0)])])))
      (m/Expanded
       .child
       (if (empty? results)
         (ui/empty-state m.Icons/search_off
                         (if (:search-busy state) "Searching…" "No matches"))
         (m/ListView
          .scrollDirection m.Axis/horizontal
          .padding (m/EdgeInsets.symmetric .horizontal 8.0 .vertical 12.0)
          .children (vec (map-indexed hit-tile results)))))])))

(defn- rename-bookmark! [ctx bm]
  (let [ctrl (m/TextEditingController. .text (or (.-title bm) "Bookmark"))]
    (-> (m/showDialog
         .context ctx
         .builder
         (fn [dctx]
           (m/AlertDialog
            .title (m/Text "Rename bookmark")
            .content (m/TextField
                      .controller ctrl
                      .autofocus true
                      .decoration (m/InputDecoration. .hintText "Name"))
            .actions
            [(m/TextButton
              .onPressed (fn [] (.pop m/Navigator dctx) nil)
              .child (m/Text "Cancel"))
             (m/TextButton
              .onPressed (fn []
                           (core/rename-bookmark! (.-id bm) (.-text ctrl))
                           (.pop m/Navigator dctx)
                           nil)
              .child (m/Text "Save"))])))
        (.whenComplete (fn []
                         (.dispose ctrl)
                         nil)))
    nil))

(defn- bookmark-tile [bm]
  (m/Builder
   .builder
   (fn [ctx]
     (mgl/MongolListTile
      .title (ui/text (or (.-title bm) "Bookmark") {:size 13.0 :max-lines 1})
      .onTap (fn []
               (store/set-ui! :bookmarks-visible false)
               (core/go-to-position! (.-position bm))
               nil)
      .trailing
      (m/Row
       .mainAxisSize m.MainAxisSize/min
       .children
       [(m/IconButton
         .tooltip "Rename bookmark"
         .icon (m/Icon m.Icons/edit_outlined .color (t/ink-muted))
         .onPressed (fn [] (rename-bookmark! ctx bm) nil))
        (m/IconButton
         .tooltip "Remove bookmark"
         .icon (m/Icon m.Icons/delete_outline .color t/danger)
         .onPressed (fn [] (core/remove-bookmark! (.-id bm)) nil))])))))

(defn- bookmarks-body [bookmarks]
  (if (empty? bookmarks)
    (ui/empty-state m.Icons/bookmarks_outlined "No bookmarks")
    (m/ListView
     .scrollDirection m.Axis/horizontal
     .padding (m/EdgeInsets.symmetric .horizontal 8.0 .vertical 12.0)
     .children (vec (map bookmark-tile bookmarks)))))

(defn- note-tile [ann]
  (mgl/MongolListTile
   .title (ui/text (or (.-note ann) "Note") {:size 13.0 :max-lines 2})
   .onTap (fn []
            (store/set-ui! :notes-visible false)
            (core/go-to-position! (.-start ann))
            nil)
   .trailing
   (m/IconButton
    .tooltip "Remove note"
    .icon (m/Icon m.Icons/delete_outline .color t/danger)
    .onPressed (fn [] (core/remove-annotation! (.-id ann)) nil))))

(defn- notes-body [annotations]
  (m/Column
   .children
   [(m/Align
     .alignment m.Alignment/centerLeft
     .child
     (m/IconButton
      .tooltip "Export notes"
      .icon (m/Icon m.Icons/file_download_outlined .color (t/ink-muted))
      .onPressed (fn [] (core/export-annotations! nil))))
    (m/Expanded
     .child
     (if (empty? annotations)
       (ui/empty-state m.Icons/notes_outlined "No notes")
       (m/ListView
        .scrollDirection m.Axis/horizontal
        .padding (m/EdgeInsets.symmetric .horizontal 8.0 .vertical 12.0)
        .children (vec (map note-tile annotations)))))]))

(defn- dismiss-panels! []
  (store/hide-panels!))

(defn- title-rail [label]
  (m/Container
   .width 44.0
   .decoration (m/BoxDecoration
                .border (m/Border
                         .right (m/BorderSide .color (t/outline) .width 1.0)))
   .child
   (m/Column
    .children
    [     (ui/icon-btn m.Icons/close_rounded
                  (fn [] (dismiss-panels!))
                  :tooltip "Close"
                  :size 18.0)
     (m/Expanded
      .child
      (m/Center
       .child
       (t/mongol-label label :size 15.0 :weight m.FontWeight/bold)))])))

(defn- modal-card [label body]
  (m/Row
   .crossAxisAlignment m.CrossAxisAlignment/stretch
   .children
   [(title-rail label)
    (m/Expanded .child body)]))

(defn- modal-shell [label body]
  (m/Positioned
   .left 0.0 .top 0.0 .right 0.0 .bottom 0.0
   .child
   (m/Stack
    .children
    [(m/ModalBarrier
      .color (t/fade (t/ink) 0.42)
      .dismissible true
      .onDismiss (fn [] (dismiss-panels!) nil))
     (m/LayoutBuilder
      .builder
      (fn [_ constraints]
        (let [max-w (max 280.0 (- (.-maxWidth constraints) 48.0))
              max-h (max 200.0 (- (.-maxHeight constraints) 48.0))]
          (m/Center
           .child
           (m/Material
            .color m.Colors/transparent
            .child
            (m/Container
             .width (min card-max-width max-w)
             .height (min card-max-height max-h)
             .decoration (m/BoxDecoration
                          .color (t/surface)
                          .borderRadius (m/BorderRadius.circular t/radius-l)
                          .border (m/Border.all .color (t/outline) .width 1.0)
                          .boxShadow t/shadow-lg)
             .clipBehavior m.Clip/antiAlias
             .child (modal-card label body)))))))])))

(defn search-stepper
  "Previous and next match, shown once a hit is open."
  []
  (f/widget
   :watch [state store/app-state]
   (let [results (:search-results state)
         n (count results)
         idx (or (:search-hit-index state) -1)
         ui-state (:ui state)]
     (if (and (pos? n)
              (:highlight state)
              (not (:search-visible ui-state)))
       (m/Positioned
        .bottom 88.0
        .left 72.0
        .right 72.0
        .child
        (m/Center
         .child
         (m/Material
          .elevation 6.0
          .color (t/surface)
          .borderRadius (m/BorderRadius.circular 20.0)
          .child
          (m/Padding
           .padding (m/EdgeInsets.symmetric .horizontal 4.0 .vertical 2.0)
           .child
           (m/Row
            .mainAxisSize m.MainAxisSize/min
            .children
            [(ui/icon-btn m.Icons/chevron_left
                          (fn [] (core/step-search! -1))
                          :tooltip "Previous match"
                          :size 20.0)
             (m/Padding
              .padding (m/EdgeInsets.symmetric .horizontal 8.0)
              .child
              (m/Text (str (if (neg? idx) 1 (inc idx)) " / " n)
                      .style (m/TextStyle .color (t/ink) .fontSize 13.0)))
             (ui/icon-btn m.Icons/chevron_right
                          (fn [] (core/step-search! 1))
                          :tooltip "Next match"
                          :size 20.0)])))))
       (m/SizedBox.shrink)))))

(defn overlay
  "Centered card over the reader. Does not resize the page row.
   Right-hand panels take precedence over the table of contents."
  [state]
  (let [ui-state (:ui state)]
    (cond
      (:search-visible ui-state)
      (modal-shell "ᠬᠠᠶᠢᠯᠲᠠ" (search-body state))

      (:bookmarks-visible ui-state)
      (modal-shell "ᠳᠡᠮᠳᠡᠭ" (bookmarks-body (:bookmarks state)))

      (:notes-visible ui-state)
      (modal-shell "ᠲᠡᠮᠳᠡᠭᠯᠡᠯ" (notes-body (:annotations state)))

      (:settings-visible ui-state)
      (modal-shell "ᠲᠣᠬᠢᠷᠠᠭᠤᠯᠬᠤ" (settings-body (:settings state)))

      (:toc-visible ui-state)
      (modal-shell "ᠭᠠᠷᠴᠠᠭ"
                   (toc/pane (or (some-> (:book state) .-toc) [])
                             (:chapter state)))

      :else
      (m/SizedBox.shrink))))

(defn- mongol-action [label on-pressed]
  (mgl/MongolTextButton
   .onPressed (when on-pressed (fn [] (on-pressed) nil))
   .child (ui/text label {:size 13.0 :color t/primary})))

(defn selection-toolbar []
  (m/Positioned
   .bottom 24.0 .left 16.0 .right 16.0
   .child
   (m/Material
    .elevation 8.0
    .color (t/surface)
    .borderRadius (m/BorderRadius.circular 12.0)
    .child
    (m/Padding
     .padding (m/EdgeInsets.symmetric .horizontal 8.0 .vertical 8.0)
     .child
     (m/SingleChildScrollView
      .scrollDirection m.Axis/horizontal
      .child
      (m/Row
       .mainAxisSize m.MainAxisSize/min
       .children
       [(mongol-action "Copy" (fn [] (core/copy-selection!)))
        (mongol-action "Yellow" (fn [] (core/add-highlight! "yellow")))
        (mongol-action "Green" (fn [] (core/add-highlight! "green")))
        (mongol-action "Blue" (fn [] (core/add-highlight! "blue")))
        (mongol-action "Pink" (fn [] (core/add-highlight! "pink")))
        (mongol-action "Underline" (fn [] (core/add-underline!)))
        (mongol-action "Note" (fn [] (core/begin-note!)))
        (mongol-action "Search" (fn [] (core/search-from-selection!)))
        (mongol-action "Share" (fn [] (core/share-selection!)))]))))))

(defn note-editor [draft]
  (m/Positioned
   .left 24.0 .right 24.0 .bottom 48.0 .height 260.0
   .child
   (m/Material
    .elevation 10.0
    .color (t/surface)
    .borderRadius (m/BorderRadius.circular 12.0)
    .child
    (m/Padding
     .padding (m/EdgeInsets.all 16.0)
     .child
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/stretch
      .children
      [(ui/text "Note" {:size 13.0 :weight m.FontWeight/bold})
       (ui/gap-h 12)
       (m/Expanded
        .child
        (mgl/MongolTextField
         .maxLines nil
         .expands true
         .decoration (m/InputDecoration
                      .hintText "Write a note"
                      .border m.InputBorder/none
                      .hintStyle (t/mongol-style :size 13.0 :color (t/ink-faint)))
         .style (t/mongol-style :size 13.0)
         .onChanged (fn [txt] (store/set-note-draft! txt))
         .onSubmitted (fn [txt] (core/save-note! txt))))
       (ui/gap-h 8)
       (m/Column
        .mainAxisAlignment m.MainAxisAlignment/end
        .children
        [(mongol-action "Cancel" (fn [] (core/clear-selection!)))
         (mongol-action "Save" (fn [] (core/save-note! draft)))])])))))
