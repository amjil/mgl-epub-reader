(ns epub-app.desktop.shortcuts
  "Nested CallbackShortcuts: page bindings fire first, then bubble to app root."
  (:require ["package:flutter/foundation.dart" :as foundation]
            ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as s]))

(defn- apple? []
  (let [p foundation/defaultTargetPlatform]
    (or (= p foundation.TargetPlatform/macOS)
        (= p foundation.TargetPlatform/iOS))))

(defn cmd-key
  [^s/LogicalKeyboardKey logical-key]
  (if (apple?)
    (m/SingleActivator logical-key .meta true)
    (m/SingleActivator logical-key .control true)))

(defn cmd-shift-key
  [^s/LogicalKeyboardKey logical-key]
  (if (apple?)
    (m/SingleActivator logical-key .meta true .shift true)
    (m/SingleActivator logical-key .control true .shift true)))

(defn raw-key
  [^s/LogicalKeyboardKey logical-key]
  (m/SingleActivator logical-key))

(defn with-shortcuts
  "Wrap `child` with CallbackShortcuts. Binding values are zero-arg fns."
  [binding-map child]
  (m/CallbackShortcuts
   .bindings binding-map
   .child child))
