(ns epub-app.services.epub-core
  "Thin ClojureDart wrapper around Dart EpubBridge."
  (:require ["package:mgl_epub_reader/mgl_epub_reader.dart" :as epub]
            ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as services]
            ["package:file_selector/file_selector.dart" :as fs]
            ["dart:async" :as async]
            ["dart:io" :as io]
            [epub-app.platform :as platform]
            [epub-app.state.store :as store]))

(defonce !bridge (atom nil))

(declare open-chapter!)

(defn init! []
  (let [b (epub.EpubBridge/create)]
    (await (.initialize b))
    (reset! !bridge b)
    (store/set-library! (await (.listBooks b)))
    (store/set-shelves! (await (.listShelves b)))
    b))

(defn dispose! []
  (when-let [b @!bridge]
    (await (.dispose b))
    (reset! !bridge nil)))

(defn- bridge []
  (or @!bridge (throw (Exception. "EpubBridge not initialized"))))

(defn refresh-shelves! []
  (store/set-shelves! (await (.listShelves (bridge)))))

(defn refresh-library! []
  (store/set-library! (await (.listBooks (bridge))))
  (await (refresh-shelves!)))

(defn- epub-type-group []
  (fs/XTypeGroup.
   .label "EPUB"
   .extensions #dart ^String ["epub" "EPUB"]
   .uniformTypeIdentifiers #dart ^String ["org.idpf.epub-container"]))

(defn- picker-fail-msg [detail]
  (str "Could not open the file picker"
       (when (seq (str detail)) (str ": " detail))
       ". On macOS add com.apple.security.files.user-selected.read-write "
       "to macos/Runner/DebugProfile.entitlements and Release.entitlements, "
       "then fully restart the app."))

(defn- pick-epub-files []
  (let [t0 (.-millisecondsSinceEpoch (dart:core/DateTime.now))
        files (try
                (await (fs/openFiles
                        .confirmButtonText "Open"
                        .acceptedTypeGroups #dart ^fs/XTypeGroup [(epub-type-group)]))
                (catch Object e
                  (dart:core/print (str "openFiles failed, retrying one file: " e))
                  (let [file (try
                               (await (fs/openFile
                                       .confirmButtonText "Open"
                                       .acceptedTypeGroups #dart ^fs/XTypeGroup [(epub-type-group)]))
                               (catch Object e2
                                 (dart:core/print (str "openFile(typed) failed, retrying unfiltered: " e2))
                                 (await (fs/openFile .confirmButtonText "Open"))))]
                    (if file [file] []))))
        dt (- (.-millisecondsSinceEpoch (dart:core/DateTime.now)) t0)]
    (when (and (empty? files) (< dt 400))
      (throw (Exception. (picker-fail-msg "dialog returned immediately"))))
    files))

(defn- import-xfile! [file]
  (let [bytes (await (.readAsBytes file))]
    (await (.importBytes (bridge) bytes))))

(defonce !picking (atom false))

(defn- import-files! [files]
  (loop [left (vec files)
         row nil]
    (if (seq left)
      (recur (rest left) (await (import-xfile! (first left))))
      row)))

(defn import-dropped! [files]
  (when-not @!picking
    (let [epubs (filterv (fn [f]
                           (.endsWith (.toLowerCase (or (.-name f) "")) ".epub"))
                         (vec (or files [])))]
      (when (seq epubs)
        (reset! !picking true)
        (store/clear-error!)
        (store/set-status! :loading-book)
        (try
          (await (import-files! epubs))
          (await (refresh-library!))
          (store/set-status! :idle)
          (catch Object e
            (store/set-error! (str e))
            (store/set-status! :error))
          (finally
            (reset! !picking false))))))
  nil)

(defn pick-and-import! []
  (if @!picking
    nil
    (do
      (reset! !picking true)
      (dart:core/print "pick-and-import!")
      (store/clear-error!)
      (try
        (let [files (vec (await (pick-epub-files)))]
          (when (seq files)
            (store/set-status! :loading-book)
            (try
              (let [row (await (import-files! files))]
                (await (refresh-library!))
                (store/set-status! :idle)
                row)
              (catch Object e
                (store/set-error! (str e))
                (store/set-status! :error)
                nil))))
        (catch Object e
          (let [raw (str e)
                msg (if (.contains raw "Could not open the file picker")
                      raw
                      (picker-fail-msg e))]
            (dart:core/print (str "pick-and-import! failed: " msg))
            (store/set-error! msg)
            (store/set-status! :error)
            nil))
        (finally
          (reset! !picking false))))))

(defn- page-index-for [pages position]
  (if (or (nil? position) (empty? pages))
    0
    (.pageIndexFor ^epub/MglEpubEngineImpl (.-engine (bridge)) pages position)))

(defn layout-config [size]
  (let [s (:settings @store/app-state)]
    (epub/ReaderLayoutConfig.
     .viewport size
     .fontSize (:font-size s)
     .lineHeight (:line-height s)
     .fontFamily (:font-family s)
     .padding (m/EdgeInsets.all (double (or (:margin s) 28.0)))
     .writingMode (if (= (:writing-mode s) :vertical)
                    epub.WritingMode/vertical
                    epub.WritingMode/horizontal)
     .readingDirection (if (= (:reading-direction s) :right-to-left)
                         epub.ReadingDirection/rightToLeft
                         epub.ReadingDirection/leftToRight))))

(defn viewport-key [size]
  (str (.toStringAsFixed (.-width size) 1)
       "x"
       (.toStringAsFixed (.-height size) 1)))

(defn- persist-progress! []
  (let [{:keys [library-book chapter pages page]} @store/app-state]
    (when (and library-book chapter (seq pages) (< page (count pages)))
      (let [cur (nth pages page)
            total (count pages)
            prog (.progressFor ^epub/MglEpubEngineImpl (.-engine (bridge))
                               .chapterId (.-id chapter)
                               .pageIndex page
                               .pageCount total)]
        (await (.saveProgress (bridge)
                              (epub/ReadingProgress.
                               .bookId (.-id library-book)
                               .chapterId (.-id chapter)
                               .blockId (.-blockId (.-start cur))
                               .offset (.-offset (.-start cur))
                               .progress prog
                               .updatedAt (dart:core/DateTime.now))))
        (store/set-progress! prog)))))

(defn paginate-current! [size]
  (let [chapter (:chapter @store/app-state)]
    (when chapter
      (let [ch-id (.-id chapter)
            gen (store/begin-paginate! (viewport-key size))]
        (try
          (let [pages (await (.paginate (bridge) ch-id (layout-config size)))]
            (when (store/paginate-matches? gen ch-id)
              (let [{:keys [pending-position landing position]} @store/app-state
                    saved (when-let [lb (:library-book @store/app-state)]
                            (await (.loadProgress (bridge) (.-id lb))))]
                (when (store/paginate-matches? gen ch-id)
                  (let [jump (:jump-fraction @store/app-state)
                        _ (store/set-jump-fraction! nil)
                        idx (cond
                              (some? jump)
                              (let [n (count pages)]
                                (if (<= n 1)
                                  0
                                  (min (dec n) (int (* (double jump) n)))))

                              (and pending-position (= (.-chapterId pending-position) ch-id))
                              (page-index-for pages pending-position)

                              (and position (= (.-chapterId position) ch-id))
                              (page-index-for pages position)

                              (= landing :last)
                              (max 0 (dec (count pages)))

                              (and saved (= (.-chapterId saved) ch-id))
                              (page-index-for pages (.-position saved))

                              :else 0)]
                    (store/set-pending-position! nil)
                    (store/set-pages! pages idx)
                    (when (seq pages)
                      (let [safe (min idx (max 0 (dec (count pages))))]
                        (store/set-position! (.-start (nth pages safe)))
                        (await (persist-progress!)))))))))
          (catch Exception e
            (when (store/paginate-matches? gen ch-id)
              (store/set-error! (str e)))))))))

(defn open-chapter!
  ([chapter-id] (open-chapter! chapter-id :first))
  ([chapter-id landing]
   (store/set-landing! landing)
   (store/set-status! :loading-chapter)
   (try
     (let [ch (await (.loadChapter (bridge) chapter-id))]
       (store/set-chapter! ch)
       ch)
     (catch Exception e
       (store/set-error! (str e))
       nil))))

(defn- format-error [e]
  (let [msg (try (.toString e) (catch Object _ (str e)))
        st (try (str (.-stackTrace e)) (catch Object _ ""))]
    (cond-> msg
      (seq st) (str "\n" st))))

(defn open-library-book! [id]
  (store/set-status! :loading-book)
  (store/clear-error!)
  (try
    (let [book (await (.openLibraryBook (bridge) id))
          row (first (filter #(= (.-id %) id) (:library @store/app-state)))
          chapters (.-chapters book)
          chapter-id (or (when-let [p (await (.loadProgress (bridge) id))]
                           (.-chapterId p))
                         (when (seq chapters)
                           (.-id (first chapters))))]
      (store/set-open-book! row book)
      (store/set-embedded-fonts! (vec (.embeddedFontFamilies (bridge))))
      (await (store/apply-book-settings! id))
      (store/set-bookmarks! (await (.listBookmarks (bridge) id)))
      (store/set-annotations! (await (.listAnnotations (bridge) id)))
      (when chapter-id
        (await (open-chapter! chapter-id :progress)))
      book)
    (catch Object e
      (let [msg (format-error e)]
        (dart:core/print (str "open-library-book! failed: " msg))
        (store/set-error! msg)
        (store/set-status! :error)
        nil))))

(defn go-to-page! [page]
  (let [pages (:pages @store/app-state)
        n (count pages)]
    (when (and (pos? n) (>= page 0) (< page n))
      (store/set-page! page)
      (store/set-position! (.-start (nth pages page)))
      (await (persist-progress!)))))

(defn next-page! []
  (let [{:keys [page pages chapter]} @store/app-state]
    (when chapter
      (cond
        (empty? pages)
        nil

        (< page (dec (count pages)))
        (go-to-page! (inc page))

        :else
        (when-let [nxt (.nextChapter ^epub/MglEpubEngineImpl (.-engine (bridge))
                                     (.-id chapter))]
          (await (open-chapter! (.-id nxt) :first)))))))

(defn previous-page! []
  (let [{:keys [page pages chapter]} @store/app-state]
    (when chapter
      (cond
        (empty? pages)
        nil

        (pos? page)
        (go-to-page! (dec page))

        :else
        (when-let [prev (.previousChapter ^epub/MglEpubEngineImpl (.-engine (bridge))
                                         (.-id chapter))]
          (await (open-chapter! (.-id prev) :last)))))))

(defn go-to-position! [position]
  (store/set-pending-position! position)
  (let [cid (.-chapterId position)
        current (some-> (:chapter @store/app-state) .-id)
        pages (:pages @store/app-state)]
    (cond
      (not= cid current)
      (await (open-chapter! cid :first))

      (seq pages)
      (do
        (store/set-pending-position! nil)
        (go-to-page! (page-index-for pages position)))

      :else nil)))

(defn- href-fragment [href]
  (when href
    (let [i (.indexOf ^String href "#")]
      (when (>= i 0)
        (let [frag (.substring ^String href (inc i))]
          (when (seq frag) frag))))))

(defn open-toc-href! [href]
  (when-let [ch (.chapterByHref (bridge) href)]
    (if (platform/desktop?)
      (store/set-ui! :search-visible false)
      (store/hide-chrome!))
    (if-let [frag (href-fragment href)]
      (let [mapped (await (.anchorBlockId (bridge) (.-id ch) frag))
            block-id (or mapped frag)]
        (await (go-to-position!
                (epub/ReaderPosition.
                 .chapterId (.-id ch)
                 .blockId block-id
                 .offset 0))))
      (await (open-chapter! (.-id ch) :first)))))

(defn- link-preview-text [resolved]
  (let [raw (or (.-text resolved) "")]
    (if (pos? (count raw))
      raw
      (if (= (.-kind resolved) "note")
        "This note has no text."
        "This link target was not found."))))

(defn open-link! [href note?]
  (let [ch (:chapter @store/app-state)]
    (when (and href ch)
      (store/clear-error!)
      (try
        (let [resolved (await (.resolveLink (bridge)
                                            href
                                            .fromChapterId (.-id ch)
                                            .note (if note? true false)))
              kind (.-kind resolved)]
          (cond
            (= kind "external")
            (when-not (await (.openExternalUrl (bridge) (.-href resolved)))
              (store/set-notice! "Could not open link"))

            (= kind "jump")
            (do
              (store/clear-link-preview!)
              (store/hide-panels!)
              (when-let [cid (.-chapterId resolved)]
                (if-let [bid (.-blockId resolved)]
                  (await (go-to-position!
                          (epub/ReaderPosition.
                           .chapterId cid
                           .blockId bid
                           .offset 0)))
                  (await (open-chapter! cid :first)))))

            :else
            (store/set-link-preview!
             {:kind kind
              :text (link-preview-text resolved)
              :chapter-id (.-chapterId resolved)
              :block-id (.-blockId resolved)
              :spans (.-spans resolved)})))
        (catch Exception e
          (store/set-notice! "Could not open link")))))
  nil)

(defn follow-link-preview! []
  (let [preview (:link-preview @store/app-state)]
    (store/clear-link-preview!)
    (store/hide-panels!)
    (when-let [cid (:chapter-id preview)]
      (if-let [bid (:block-id preview)]
        (go-to-position!
         (epub/ReaderPosition.
          .chapterId cid
          .blockId bid
          .offset 0))
        (open-chapter! cid :first))))
  nil)

(defn add-bookmark! []
  (let [{:keys [library-book position chapter]} @store/app-state]
    (when (and library-book position)
      (await (.addBookmark (bridge)
                           .bookId (.-id library-book)
                           .position position
                           .title (some-> chapter .-title)))
      (store/set-bookmarks!
       (await (.listBookmarks (bridge) (.-id library-book)))))))

(defn remove-bookmark! [id]
  (await (.removeBookmark (bridge) id))
  (when-let [lb (:library-book @store/app-state)]
    (store/set-bookmarks! (await (.listBookmarks (bridge) (.-id lb))))))

(defonce !search-gen (atom 0))

(defn search! [query]
  (let [gen (swap! !search-gen inc)
        q (or query "")]
    (store/set-search! q [])
    (store/set-highlight! nil)
    (if (seq (.trim q))
      (let [book (:book @store/app-state)
            current (some-> (:chapter @store/app-state) .-id)
            ids (mapv (fn [ch] (.-id ch)) (or (some-> book .-chapters) []))
            ordered (vec (concat (filter #(= % current) ids)
                                 (remove #(= % current) ids)))]
        (store/set-search-busy! true)
        (try
          (loop [left ordered
                 acc []]
            (when (and (= gen @!search-gen) (seq left) (< (count acc) 40))
              (let [hits (vec (or (await (.searchChapter (bridge)
                                                         (first left)
                                                         q
                                                         .limit (- 40 (count acc))))
                                  []))
                    found (into acc hits)]
                (when (= gen @!search-gen)
                  (store/set-search-results! found)
                  (recur (next left) found)))))
          (finally
            (when (= gen @!search-gen)
              (store/set-search-busy! false)))))
      (store/set-search-busy! false))))

(defn go-to-fraction! [fraction]
  (let [book (:book @store/app-state)
        chapters (vec (or (some-> book .-chapters) []))
        n (count chapters)]
    (when (pos? n)
      (let [f (max 0.0 (min 0.999 (double (or fraction 0.0))))
            scaled (* f n)
            i (min (dec n) (int scaled))
            within (- scaled i)
            ch (nth chapters i)
            cur (some-> (:chapter @store/app-state) .-id)]
        (if (= cur (.-id ch))
          (let [pages (:pages @store/app-state)
                total (count pages)
                idx (if (<= total 1)
                      0
                      (min (dec total) (int (* within total))))]
            (go-to-page! idx))
          (do
            (store/set-jump-fraction! within)
            (open-chapter! (.-id ch) :first))))))
  nil)

(defn go-to-search-hit!
  ([hit] (go-to-search-hit! hit nil))
  ([hit idx]
   (when hit
     (when (some? idx)
       (store/set-search-hit-index! idx))
     (store/set-highlight!
      (epub/ReaderSelectionRange.
       .chapterId (.-chapterId hit)
       .blockId (.-blockId hit)
       .start (.-offset hit)
       .end (+ (.-offset hit) (.-length hit))))
     (store/set-ui! :search-visible false)
     (go-to-position! (.-position hit)))))

(defn step-search! [delta]
  (let [results (:search-results @store/app-state)
        n (count results)]
    (when (pos? n)
      (let [cur (or (:search-hit-index @store/app-state) -1)
            next (cond
                   (neg? cur) (if (neg? delta) (dec n) 0)
                   (and (neg? delta) (zero? cur)) (dec n)
                   (and (pos? delta) (>= cur (dec n))) 0
                   :else (+ cur delta))]
        (go-to-search-hit! (nth results next) next))))
  nil)

(defn select-span! [^epub/MglBlock block start end text]
  (when-let [ch (:chapter @store/app-state)]
    (let [from (int start)
          to (int end)]
      (when (> to from)
        (store/set-selection!
         (epub/ReaderSelection.
          .chapterId (.-id ch)
          .blockId (.-id block)
          .startOffset from
          .endOffset to
          .text (or text "")))
        (store/set-ui! :menu-visible true)
        (store/set-ui! :note-visible false)))))

(defn clear-selection! []
  (store/set-selection! nil)
  (store/set-note-draft! "")
  (store/set-ui! :note-visible false))

(defn copy-selection! []
  (when-let [sel (:selection @store/app-state)]
    (services/Clipboard.setData (services/ClipboardData. .text (.-text sel)))
    (clear-selection!)))

(defn search-from-selection! []
  (when-let [sel (:selection @store/app-state)]
    (let [q (.-text sel)]
      (store/set-selection! nil)
      (store/set-ui! :note-visible false)
      (store/show-panel! :search-visible)
      (search! q))))

(defn- annotation-from-selection [style color note]
  (let [{:keys [library-book selection]} @store/app-state]
    (when (and library-book selection)
      (epub/Annotation.
       .id ""
       .bookId (.-id library-book)
       .chapterId (.-chapterId selection)
       .start (.-start selection)
       .end (.-end selection)
       .style style
       .color color
       .note note
       .createdAt (dart:core/DateTime.now)))))

(defn- persist-annotation! [ann]
  (when ann
    (await (.addAnnotation (bridge) ann))
    (store/set-annotations!
     (await (.listAnnotations (bridge) (.-bookId ann))))
    (clear-selection!)))

(defn add-highlight!
  ([] (add-highlight! "yellow"))
  ([color]
   (persist-annotation!
    (annotation-from-selection epub.AnnotationStyle/highlight (or color "yellow") nil))))

(defn add-underline! []
  (persist-annotation!
   (annotation-from-selection epub.AnnotationStyle/underline "yellow" nil)))

(defn begin-note! []
  (when (:selection @store/app-state)
    (store/set-note-draft! "")
    (store/set-ui! :note-visible true)))

(defn save-note! [text]
  (when-let [sel (:selection @store/app-state)]
    (let [ch (:chapter @store/app-state)
          quote (.-text sel)
          payload (if (seq text)
                    (str text "\n\n“" quote "”")
                    (str "“" quote "”"))]
      (try
        (.noteFromSelection (bridge) sel (some-> ch .-title))
        (catch Exception e
          (dart:core/print (str "note metadata failed: " e))))
      (persist-annotation!
       (annotation-from-selection epub.AnnotationStyle/note "yellow" payload)))))

(defn share-selection! []
  (when-let [sel (:selection @store/app-state)]
    (let [book (:book @store/app-state)
          ch (:chapter @store/app-state)
          cite (str "\"" (.-text sel) "\"\n— "
                    (or (some-> book .-title) "")
                    (if ch (str ", " (.-title ch)) ""))]
      (try
        (await (.shareText (bridge) cite))
        (catch Object e
          (dart:core/print (str "share failed, copying instead: " e))
          (services/Clipboard.setData (services/ClipboardData. .text cite))
          (store/set-notice! "Copied. Sharing is unavailable on this device.")))
      (clear-selection!))))

(defn- export-body []
  (let [{:keys [book bookmarks annotations]} @store/app-state
        title (or (some-> book .-title) "Book")
        marks (apply str
                     (map (fn [bm]
                            (str "- " (or (.-title bm) "Bookmark") "\n"))
                          bookmarks))
        notes (apply str
                     (map (fn [ann]
                            (str "- [" (.-color ann) " "
                                 (.name (.-style ann)) "] "
                                 (or (.-note ann) "") "\n"))
                          annotations))]
    (str title "\n\nBookmarks\n" marks "\nHighlights and notes\n" notes)))

(defn export-annotations! []
  (try
    (let [loc (await (fs/getSaveLocation
                      .suggestedName "notes.txt"
                      .confirmButtonText "Export"))]
      (when-let [path (some-> loc .-path)]
        (when (seq path)
          (await (.writeAsString (io/File. path) (export-body)))
          (store/set-notice! "Exported notes"))))
    (catch Object e
      (store/set-notice! (str "Could not export notes: " e))))
  nil)

(defn rename-bookmark! [id title]
  (let [name (.trim (or title ""))]
    (when (and id (seq name))
      (await (.renameBookmark (bridge) id name))
      (when-let [lb (:library-book @store/app-state)]
        (store/set-bookmarks! (await (.listBookmarks (bridge) (.-id lb)))))))
  nil)

(defn remove-annotation! [id]
  (await (.removeAnnotation (bridge) id))
  (when-let [lb (:library-book @store/app-state)]
    (store/set-annotations! (await (.listAnnotations (bridge) (.-id lb))))))

(defn create-shelf! [name]
  (let [n (.trim (or name ""))]
    (when (seq n)
      (await (.createShelf (bridge) n))
      (await (refresh-shelves!))))
  nil)

(defn delete-shelf! [id]
  (when (seq (or id ""))
    (await (.deleteShelf (bridge) id))
    (when (= id (:library-filter @store/app-state))
      (store/set-library-filter! :all))
    (await (refresh-library!)))
  nil)

(defn set-book-shelf! [book-id shelf-id]
  (when book-id
    (await (.setBookShelf (bridge) book-id shelf-id))
    (await (refresh-library!)))
  nil)

(defn toggle-favorite! [id favorite]
  (await (.setFavorite (bridge) id favorite))
  (await (refresh-library!)))

(defn set-finished! [id finished]
  (await (.setFinished (bridge) id finished))
  (await (refresh-library!)))

(defn remove-book! [id]
  (let [current (:library-book @store/app-state)]
    (when (and current (= (.-id current) id))
      (when-let [eng (some-> @!bridge .-engine)]
        (.close ^epub/MglEpubEngineImpl eng))
      (store/close-book!)))
  (await (.removeBook (bridge) id))
  (await (refresh-library!)))

(defn ^#/(async/Future #/(List int)) load-image [^String resource-id]
  (.loadResource ^epub/EpubBridge (bridge) resource-id))

(defn theme-colors []
  (.themeNamed (bridge) (name (:theme (:settings @store/app-state)))))

(defn close-book! []
  (when-let [eng (some-> @!bridge .-engine)]
    (.close ^epub/MglEpubEngineImpl eng))
  (store/set-embedded-fonts! [])
  (store/close-book!))
