(ns epub-app.widgets.ui
  "Chrome helpers for traditional Mongolian UI.
   A line of script grows downward; columns advance left to right,
   so pages are Rows and lists scroll horizontally."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [epub-app.theme :as t]))

(defn gap-h [n] (m/SizedBox .width (double n)))

(defn text
  ([s] (text s {}))
  ([s {:keys [size color weight max-lines]
       :or {size 16.0 color t/ink}}]
   (t/mongol-label s
                   :size size
                   :color color
                   :weight weight
                   :max-lines max-lines
                   :align mgl.MongolTextAlign/top)))

(defn pill
  [{:keys [label active? on-tap]}]
  (m/GestureDetector
   .onTap on-tap
   .child
   (m/AnimatedContainer
    .duration (dart:core/Duration. .milliseconds 160)
    .margin (m.EdgeInsets/symmetric .vertical 4.0)
    .padding (m.EdgeInsets/symmetric .horizontal 7.0 .vertical 10.0)
    .decoration (m/BoxDecoration
                 .color (if active? t/primary-soft (t/fade t/surface 0.0))
                 .borderRadius (m.BorderRadius/circular t/radius-s)
                 .border (m/Border.all
                          .color (if active? t/primary t/outline)
                          .width 1.0))
    .child (text label {:size 13.0
                        :color (if active? t/primary t/ink-muted)
                        :weight (when active? m.FontWeight/w600)}))))

(defn empty-state
  [icon message]
  (m/Center
   .child
   (m/Row
    .mainAxisSize m.MainAxisSize/min
    .children
    [(m/Icon icon .size 36.0 .color t/ink-muted)
     (gap-h 16)
     (text message {:size 16.0 :color t/ink-muted})])))

(defn v-progress
  [value]
  (m/Container
   .width 4.0
   .margin (m.EdgeInsets/symmetric .vertical 8.0)
   .decoration (m/BoxDecoration
                .color t/surface-2
                .borderRadius (m.BorderRadius/circular 2.0))
   .child
   (m/Align
    .alignment m.Alignment/topCenter
    .child
    (m/FractionallySizedBox
     .heightFactor (max 0.0 (min 1.0 (or value 0.0)))
     .widthFactor 1.0
     .child
     (m/Container
      .decoration (m/BoxDecoration
                   .color t/primary
                   .borderRadius (m.BorderRadius/circular 2.0)))))))

(defn icon-btn
  [icon on-pressed & {:keys [tooltip color filled?]
                      :or {color t/ink-muted}}]
  (m/IconButton
   .tooltip tooltip
   .style (when filled?
            (m/IconButton.styleFrom
             .backgroundColor t/primary-soft
             .foregroundColor t/primary))
   .icon (m/Icon icon .color (if filled? t/primary color))
   .onPressed on-pressed))

(defn card-shell
  [child & {:keys [width on-tap margin elevated?]
            :or {width 148.0}}]
  (m/Container
   .width width
   .margin (or margin (m.EdgeInsets/symmetric .horizontal 6.0 .vertical 16.0))
   .clipBehavior m.Clip/antiAlias
   .decoration (m/BoxDecoration
                .color t/surface
                .borderRadius (m.BorderRadius/circular t/radius-m)
                .boxShadow (if elevated?
                             [(m/BoxShadow
                               .color (t/fade t/ink 0.12)
                               .blurRadius 22.0
                               .offset (m/Offset. 0.0 8.0))]
                             (t/card-shadow)))
   .child
   (m/Material
    .color t/surface
    .child
    (m/InkWell
     .onTap on-tap
     .child
     (m/Padding
      .padding (m.EdgeInsets/all 12.0)
      .child child)))))

(defn side-sheet
  [side width child]
  (m/Positioned
   .top 0.0 .bottom 0.0
   .left (when (= side :left) 0.0)
   .right (when (= side :right) 0.0)
   .width width
   .child
   (m/Material
    .elevation 8.0
    .color t/surface
    .child child)))

(defn v-slider [min-v max-v value on-change]
  (m/RotatedBox
   .quarterTurns 3
   .child
   (m/SizedBox
    .width 180.0
    .child
    (m/Slider
     .min min-v
     .max max-v
     .value value
     .onChanged on-change))))

(defn- latin-style [size color]
  (m/TextStyle
   .fontFamily "Courier"
   .fontFamilyFallback #dart ^String ["Menlo" "monospace" "Courier New"]
   .fontSize size
   .height 1.35
   .color color))

(defn error-banner
  "Horizontal Latin error so Dart exceptions stay readable in a Mongol UI."
  [msg on-dismiss]
  (m/Positioned
   .left 12.0 .right 12.0 .bottom 12.0
   .child
   (m/Material
    .color t/danger
    .elevation 8.0
    .borderRadius (m.BorderRadius/circular t/radius-s)
    .child
    (m/ConstrainedBox
     .constraints (m/BoxConstraints .maxHeight 240.0)
     .child
     (m/Padding
      .padding (m.EdgeInsets/fromLTRB 12.0 8.0 4.0 12.0)
      .child
      (m/Row
       .crossAxisAlignment m.CrossAxisAlignment/start
       .children
       [(m/Expanded
         .child
         (m/SingleChildScrollView
          .child
          (m/SelectableText (or msg "")
                            .style (latin-style 13.0 m.Colors/white))))
        (m/IconButton
         .icon (m/Icon m.Icons/close .color m.Colors/white .size 20.0)
         .onPressed (fn [] (when on-dismiss (on-dismiss)) nil))]))))))
