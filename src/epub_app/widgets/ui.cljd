(ns epub-app.widgets.ui
  "传统蒙古文UI组件库 - 现代化设计"
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["dart:ui" :as ui-core]
            [epub-app.theme :as t]))

(defn gap-h [n] (m/SizedBox .width (double n)))
(defn gap-v [n] (m/SizedBox .height (double n)))

(defn text
  ([s] (text s {}))
  ([s {:keys [size color weight max-lines]
       :or {size 16.0 color (t/ink)}}]
   (t/mongol-label s
                   :size size
                   :color color
                   :weight weight
                   :max-lines max-lines
                   :align mgl.MongolTextAlign/top)))

;; 改进的按钮样式
(defn pill
  [{:keys [label active? on-tap]}]
  (m/GestureDetector
   .onTap on-tap
   .child
   (m/AnimatedContainer
    .duration (dart:core/Duration. .milliseconds 200)
    .margin (m/EdgeInsets.symmetric .vertical 5.0)
    .padding (m/EdgeInsets.symmetric .horizontal 10.0 .vertical 14.0)
    .decoration (m/BoxDecoration
                 .color (if active? t/primary-soft (t/fade (t/surface) 0.0))
                 .borderRadius (m/BorderRadius.circular t/radius-m)
                 .border (m/Border.all
                          .color (if active? t/primary (t/outline))
                          .width (if active? 2.0 1.0))
                 .boxShadow (when active? t/shadow-sm))
    .child (text label {:size 14.0
                        :color (if active? t/primary (t/ink-muted))
                        :weight (when active? m.FontWeight/w600)}))))

;; 改进的空状态显示
(defn empty-state
  [icon message & {:keys [subtitle action-label on-action]}]
  (m/Center
   .child
   (m/Row
    .mainAxisSize m.MainAxisSize/min
    .children
    (filterv some?
             [(m/Container
               .width 68.0
               .height 68.0
               .decoration (m/BoxDecoration
                            .color (t/fade t/primary-soft 0.6)
                            .borderRadius (m/BorderRadius.circular t/radius-l))
               .child (m/Center
                       .child (m/Icon icon .size 36.0 .color t/primary)))
              (gap-h 20)
              (m/Column
               .mainAxisSize m.MainAxisSize/min
               .crossAxisAlignment m.CrossAxisAlignment/start
               .children
               (filterv some?
                        [(text message {:size 18.0 :weight m.FontWeight/w600})
                         (when subtitle
                           (m/Padding
                            .padding (m/EdgeInsets.only .top 6.0)
                            .child (text subtitle {:size 14.0 :color (t/ink-muted)})))
                         (when (and action-label on-action)
                           (m/Padding
                            .padding (m/EdgeInsets.only .top 12.0)
                            .child
                            (m/ElevatedButton
                             .onPressed on-action
                             .style (m/ElevatedButton.styleFrom
                                     .backgroundColor t/primary
                                     .foregroundColor m.Colors/white
                                     .padding (m/EdgeInsets.symmetric
                                               .horizontal 20.0 .vertical 12.0)
                                     .shape (m/RoundedRectangleBorder
                                             .borderRadius (m/BorderRadius.circular t/radius-m)))
                             .child (text action-label
                                          {:size 14.0
                                           :color m.Colors/white
                                           :weight m.FontWeight/w500}))))]))]))))

;; 改进的垂直进度条
(defn v-progress
  [value]
  (m/Container
   .width 5.0
   .margin (m/EdgeInsets.symmetric .vertical 10.0)
   .decoration (m/BoxDecoration
                .color (t/surface-2)
                .borderRadius (m/BorderRadius.circular 3.0))
   .child
   (m/Align
    .alignment m.Alignment/topCenter
    .child
    (m/AnimatedContainer
     .duration (dart:core/Duration. .milliseconds 300)
     .child
     (m/FractionallySizedBox
      .heightFactor (max 0.0 (min 1.0 (or value 0.0)))
      .widthFactor 1.0
      .child
      (m/Container
       .decoration (m/BoxDecoration
                    .gradient (m/LinearGradient
                               .begin m.Alignment/topCenter
                               .end m.Alignment/bottomCenter
                               .colors [t/primary t/primary-deep])
                    .borderRadius (m/BorderRadius.circular 3.0)
                    .boxShadow [(m/BoxShadow
                                 .color (t/fade t/primary 0.3)
                                 .blurRadius 4.0
                                 .offset (m/Offset. 0.0 2.0))])))))))

;; 改进的图标按钮
(defn icon-btn
  [icon on-pressed & {:keys [tooltip color filled? size]
                      :or {color (t/ink-muted) size 24.0}}]
  (m/IconButton
   .tooltip tooltip
   .iconSize size
   .style (when filled?
            (m/IconButton.styleFrom
             .backgroundColor t/primary-soft
             .foregroundColor t/primary
             .padding (m/EdgeInsets.all 12.0)
             .shape (m/RoundedRectangleBorder
                     .borderRadius (m/BorderRadius.circular t/radius-m))))
   .icon (m/Icon icon .color (if filled? t/primary color) .size size)
   .onPressed on-pressed))

;; 毛玻璃效果背景
(defn frosted
  [child & {:keys [opacity elevation]
            :or {opacity 0.75 elevation 0.0}}]
  (m/ClipRect
   .child
   (m/BackdropFilter
    .filter (ui-core/ImageFilter.blur .sigmaX 16.0 .sigmaY 16.0)
    .child
    (m/Material
     .elevation elevation
     .color (t/fade (t/surface) opacity)
     .shadowColor (t/fade (t/ink) 0.08)
     .child child))))

;; 改进的卡片容器
(defn card-shell
  [child & {:keys [width height on-tap margin elevated? padding]
            :or {width 160.0 padding 14.0}}]
  (m/Container
   .width width
   .height height
   .margin (or margin (m/EdgeInsets.symmetric .horizontal 8.0 .vertical 18.0))
   .clipBehavior m.Clip/antiAlias
   .decoration (m/BoxDecoration
                .color (t/surface)
                .borderRadius (m/BorderRadius.circular t/radius-l)
                .border (m/Border.all .color (t/outline) .width 1.0)
                .boxShadow (if elevated? t/shadow-lg (t/card-shadow)))
   .child
   (m/Material
    .color (t/surface)
    .child
    (m/InkWell
     .onTap on-tap
     .splashColor (t/fade t/primary 0.1)
     .highlightColor (t/fade t/primary 0.05)
     .child
     (m/Padding
      .padding (m/EdgeInsets.all padding)
      .child child)))))

;; 侧边面板
(defn side-sheet
  [side width child]
  (m/Positioned
   .top 0.0 .bottom 0.0
   .left (when (= side :left) 0.0)
   .right (when (= side :right) 0.0)
   .width width
   .child
   (m/AnimatedContainer
    .duration t/pane-anim
    .child (frosted child :elevation 12.0 :opacity 0.92))))

;; 改进的垂直滑块
(defn v-slider [min-v max-v value on-change & {:keys [label]}]
  (m/Column
   .mainAxisSize m.MainAxisSize/min
   .children
   (filterv some?
            [(when label
               (text label {:size 13.0 :color (t/ink-muted)}))
             (when label (gap-v 8))
             (m/RotatedBox
              .quarterTurns 3
              .child
              (m/SizedBox
               .width 200.0
               .child
               (m/SliderTheme
                .data (m/SliderThemeData
                       .activeTrackColor t/primary
                       .inactiveTrackColor (t/surface-2)
                       .thumbColor t/primary
                       .overlayColor (t/fade t/primary 0.1)
                       .trackHeight 4.0)
                .child
                (m/Slider
                 .min min-v
                 .max max-v
                 .value value
                 .onChanged on-change))))])))

;; 拉丁字符样式(用于错误信息)
(defn- latin-style [size color]
  (m/TextStyle
   .fontFamily "Courier"
   .fontFamilyFallback #dart ^String ["Menlo" "monospace" "Courier New"]
   .fontSize size
   .height 1.4
   .letterSpacing 0.2
   .color color))

;; 改进的错误横幅
(defn error-banner
  [msg on-dismiss]
  (m/Positioned
   .left 16.0 .right 16.0 .bottom 16.0
   .child
   (m/AnimatedContainer
    .duration (dart:core/Duration. .milliseconds 300)
    .child
    (m/Material
     .color t/danger
     .elevation 12.0
     .shadowColor (t/fade t/danger 0.3)
     .borderRadius (m/BorderRadius.circular t/radius-m)
     .child
     (m/ConstrainedBox
      .constraints (m/BoxConstraints .maxHeight 280.0)
      .child
      (m/Padding
       .padding (m/EdgeInsets.fromLTRB 16.0 12.0 4.0 12.0)
       .child
       (m/Row
        .crossAxisAlignment m.CrossAxisAlignment/start
        .children
        [(m/Padding
          .padding (m/EdgeInsets.only .top 2.0)
          .child (m/Icon m.Icons/error_outline .color m.Colors/white .size 22.0))
         (gap-h 12)
         (m/Expanded
          .child
          (m/SingleChildScrollView
           .child
           (m/SelectableText (or msg "")
                             .style (latin-style 13.0 m.Colors/white))))
         (m/IconButton
          .icon (m/Icon m.Icons/close .color m.Colors/white .size 20.0)
          .onPressed (fn [] (when on-dismiss (on-dismiss)) nil))])))))))

;; 加载指示器
(defn loading-indicator
  [& {:keys [message]}]
  (m/Center
   .child
   (m/Row
    .mainAxisSize m.MainAxisSize/min
    .children
    [(m/SizedBox
      .width 32.0
      .height 32.0
      .child (m/CircularProgressIndicator
              .strokeWidth 3.0
              .valueColor (m/AlwaysStoppedAnimation t/primary)))
     (when message
       (gap-h 16))
     (when message
       (text message {:size 15.0 :color (t/ink-muted)}))])))

;; 分隔线
(defn divider
  [& {:keys [horizontal? thickness margin]
      :or {horizontal? true thickness 1.0}}]
  (if horizontal?
    (m/Container
     .height thickness
     .margin (or margin (m/EdgeInsets.symmetric .vertical 8.0))
     .color (t/outline))
    (m/Container
     .width thickness
     .margin (or margin (m/EdgeInsets.symmetric .horizontal 8.0))
     .color (t/outline))))

;; 徽章
(defn badge
  [content & {:keys [color bg-color size]
              :or {color m.Colors/white bg-color t/primary size 20.0}}]
  (m/Container
   .width size
   .height size
   .decoration (m/BoxDecoration
                .color bg-color
                .borderRadius (m/BorderRadius.circular (/ size 2.0))
                .boxShadow t/shadow-sm)
   .child
   (m/Center
    .child
    (if (string? content)
      (text content {:size (* size 0.5) :color color :weight m.FontWeight/w600})
      content))))
