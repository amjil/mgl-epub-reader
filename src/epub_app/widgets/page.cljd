(ns epub-app.widgets.page
  "Shared paginated page view used by mobile and desktop readers."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mgl_epub_reader/mgl_epub_reader.dart" :as epub]
            [epub-app.services.epub-core :as core]
            [epub-app.state.store :as store]))

(defn needs-paginate? [state size]
  (and (:chapter state)
       (pos? (.-width size))
       (pos? (.-height size))
       (let [key (core/viewport-key size)
             stale? (or (empty? (:pages state))
                        (not= (:viewport-key state) key))
             failed-this-size? (and (= (:status state) :error)
                                    (= (:viewport-key state) key))]
         (and stale? (not failed-this-size?)))))

(defn already-paginating-for? [state size]
  (and (= (:status state) :paginating)
       (= (:viewport-key state) (core/viewport-key size))))

(defn schedule-paginate! [state size]
  (when (and (needs-paginate? state size)
             (not (already-paginating-for? state size)))
    (.addPostFrameCallback
     m.WidgetsBinding/instance
     (fn [_]
       (let [s @store/app-state]
         (when (and (needs-paginate? s size)
                    (not (already-paginating-for? s size)))
           (core/paginate-current! size)))))))

(defn- page-view [pg size state]
  (let [ch-id (some-> (:chapter state) .-id)
        anns (if ch-id
               (filterv #(= (.-chapterId %) ch-id) (:annotations state))
               (:annotations state))]
    (epub/MglPageView.
     .page pg
     .config (core/layout-config size)
     .colors (core/theme-colors)
     .loadImage core/load-image
     .annotations anns
     .selection (:selection state)
     .highlight (:highlight state)
     .onBlockLongPress (fn [block] (core/select-block! block))
     .onLinkTap (fn [href] (core/open-link! href)))))

(defn view [state size]
  (let [pages (:pages state)
        n (count pages)
        page (if (pos? n) (min (max (:page state) 0) (dec n)) 0)]
    (if (empty? pages)
      (m/Center .child (m/CircularProgressIndicator.))
      (let [cur (nth pages page)
            prev (when (pos? page) (nth pages (dec page)))
            nxt (when (< page (dec n)) (nth pages (inc page)))]
        (m/Stack
         .fit m.StackFit/expand
         .children
         (filterv some?
                  [(when prev
                     (m/Offstage .offstage true .child (page-view prev size state)))
                   (page-view cur size state)
                   (when nxt
                     (m/Offstage .offstage true .child (page-view nxt size state)))]))))))
