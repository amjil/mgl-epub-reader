(ns epub-app.widgets.link-preview
  "Small card for footnote and fragment targets."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mgl_epub_reader/mgl_epub_reader.dart" :as epub]
            [epub-app.services.epub-core :as core]
            [epub-app.state.store :as store]
            [epub-app.theme :as t]
            [epub-app.widgets.ui :as ui]))

(def ^:private card-max-width 420.0)
(def ^:private card-max-height 360.0)

(defn- dismiss! []
  (store/clear-link-preview!)
  nil)

(defn- title-rail [preview]
  (let [title (if (= (:kind preview) "note") "ᠲᠠᠢᠯᠪᠤᠷᠢ" "ᠬᠣᠯᠪᠣᠭᠠᠰᠤ")]
    (m/Container
     .width 44.0
     .decoration (m/BoxDecoration
                  .border (m/Border
                           .right (m/BorderSide .color (t/outline) .width 1.0)))
     .child
     (m/Column
      .children
      (filterv some?
               [(ui/icon-btn m.Icons/close_rounded
                             dismiss!
                             :tooltip "Close"
                             :size 18.0)
                (when (:chapter-id preview)
                  (ui/icon-btn m.Icons/menu_book_outlined
                               (fn [] (core/follow-link-preview!) nil)
                               :tooltip "Open in book"
                               :size 18.0))
                (m/Expanded
                 .child
                 (m/Center
                  .child
                  (t/mongol-label title
                                  :size 15.0
                                  :weight m.FontWeight/bold)))])))))

(defn- preview-body [preview vertical?]
  (let [child (epub/LinkRichText.
               .fallback (or (:text preview) "")
               .vertical vertical?
               .spans (:spans preview)
               .color (t/ink)
               .linkColor t/primary
               .onLinkTap (fn [href note?]
                            (core/open-link! href note?)
                            nil))]
    (if vertical?
      (m/ListView
       .scrollDirection m.Axis/horizontal
       .padding (m/EdgeInsets.symmetric .horizontal 16.0 .vertical 12.0)
       .children [child])
      (m/ListView
       .padding (m/EdgeInsets.all 16.0)
       .children [child]))))

(defn- card [preview vertical?]
  (m/Row
   .crossAxisAlignment m.CrossAxisAlignment/stretch
   .children
   [(title-rail preview)
    (m/Expanded
     .child (preview-body preview vertical?))]))

(defn layer
  "Dimmed card over the reader. Anchors to bottom on mobile for thumb reach."
  [preview vertical?]
  (m/Positioned
   .left 0.0 .top 0.0 .right 0.0 .bottom 0.0
   .child
   (m/AnimatedSwitcher
    .duration (dart:core/Duration. .milliseconds 200)
    .child
    (if preview
      (m/SizedBox.expand
       .key (m/ValueKey. (str (:chapter-id preview) "-" (:text preview)))
       .child
       (m/Stack
        .children
        [(m/ModalBarrier
          .color (t/fade (t/ink) 0.42)
          .dismissible true
          .onDismiss dismiss!)
         (m/LayoutBuilder
          .builder
          (fn [_ constraints]
            (let [avail-w (.-maxWidth constraints)
                  avail-h (.-maxHeight constraints)
                  mobile-layout? (< avail-w 600.0)
                  max-w (if mobile-layout?
                          (- avail-w 24.0)
                          (min card-max-width (max 280.0 (- avail-w 48.0))))
                  max-h (if mobile-layout?
                          (min 280.0 (* avail-h 0.45))
                          (min card-max-height (max 200.0 (- avail-h 48.0))))]
              (m/Align
               .alignment (if mobile-layout?
                            m.Alignment/bottomCenter
                            m.Alignment/center)
               .child
               (m/Padding
                .padding (if mobile-layout?
                           (m.EdgeInsets/fromLTRB 12.0 0.0 12.0 24.0)
                           m.EdgeInsets/zero)
                .child
                (m/Material
                 .color m.Colors/transparent
                 .child
                 (m/Container
                  .width max-w
                  .height max-h
                  .decoration (m/BoxDecoration
                               .color (t/surface)
                               .borderRadius (m/BorderRadius.circular t/radius-l)
                               .border (m/Border.all .color (t/outline) .width 1.0)
                               .boxShadow t/shadow-lg)
                  .clipBehavior m.Clip/antiAlias
                  .child (card preview vertical?))))))))]))
      (m/SizedBox.shrink
       .key (m/ValueKey. "link-preview-closed"))))))
