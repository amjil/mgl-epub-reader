(ns epub-app.widgets.books
  "Book cards, shelf filters, and the cover overflow menu."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["dart:io" :as io]
            [cljd.flutter :as f]
            [epub-app.services.epub-core :as core]
            [epub-app.state.store :as store]
            [epub-app.theme :as t]
            [epub-app.widgets.ui :as ui]))

(def filters
  [[:all "ᠪᠦᠬᠦ"]
   [:recent "ᠰᠠᠶᠢᠬᠠᠨ"]
   [:favorites "ᠬᠠᠳᠠᠭᠠᠯᠠᠭᠰᠠᠨ"]
   [:finished "ᠤᠩᠰᠢᠭᠰᠠᠨ"]])

(defn- reading-history [books]
  ;; Opened books with progress, not the first 20 imports.
  (vec (take 30
             (filterv (fn [b]
                        (or (.-finished b)
                            (> (or (.-progress b) 0.0) 0.0)))
                      books))))

(defn matches-query? [book query]
  (let [q (.toLowerCase (or query ""))
        title (.toLowerCase (or (.-title book) ""))
        author (.toLowerCase (or (.-author book) ""))]
    (and (seq q)
         (or (.contains title q) (.contains author q)))))

(defn filtered-books [state]
  (let [books (:library state)
        f (:library-filter state)
        shelf (cond
                (= f :favorites) (filterv #(.-favorite %) books)
                (= f :finished) (filterv #(.-finished %) books)
                (= f :recent) (reading-history books)
                (string? f) (filterv #(= f (.-collectionId %)) books)
                :else (vec books))
        q (or (:library-search-query state) "")]
    (if (seq q)
      (filterv #(matches-query? % q) shelf)
      shelf)))

(defn opened-label [book]
  (when-let [at (.-lastOpenedAt book)]
    (let [m (.-month at)
          d (.-day at)
          pad (fn [n] (if (< n 10) (str "0" n) (str n)))]
      (str (.-year at) "-" (pad m) "-" (pad d)))))

;; Delete confirmation dialog
(defn confirm-delete! [ctx book]
  (m/showDialog
   .context ctx
   .builder
   (fn [c]
     (mgl/MongolAlertDialog
      .backgroundColor (t/surface)
      .shape (m/RoundedRectangleBorder
              .borderRadius (m/BorderRadius.circular t/radius-l))
      .title (t/mongol-label "ᠬᠠᠰᠤᠬᠤ ᠤᠤ?" :size 18.0 :weight m.FontWeight/bold)
      .content (m/Padding
                .padding (m/EdgeInsets.symmetric .vertical 8.0)
                .child (ui/text (or (.-title book) "")
                                {:size 16.0 :color (t/ink-muted)}))
      .actions
      [(m/TextButton
        .onPressed (fn [] (.pop (m/Navigator.of c)))
        .child (t/mongol-label "ᠦᠭᠡᠢ" :color (t/ink-muted) :weight m.FontWeight/w500))
       (m/ElevatedButton
        .onPressed (fn []
                     (.pop (m/Navigator.of c))
                     (core/remove-book! (.-id book)))
        .style (m/ElevatedButton.styleFrom
                .backgroundColor t/danger
                .foregroundColor m.Colors/white
                .padding (m/EdgeInsets.symmetric .horizontal 16.0 .vertical 10.0))
        .child (t/mongol-label "ᠬᠠᠰᠤᠬᠤ" :color m.Colors/white :weight m.FontWeight/w500))]))))

;; Vertical labels need a slot as tall as the string. The shared popup sizes
;; that column from MongolText's max intrinsic height, which is about one em
;; (the 27px box that overflowed), so the book menu lays itself out.

(defn- label-slot [title]
  ;; One em per letter, plus slack so the last glyph is not flush with the clip.
  (+ 12.0 (* 20.0 (double (max 1 (count (or title "")))))))

(defn- menu-block-height [items available]
  (let [text-h (reduce (fn [m item]
                         (if (= :item (:type item))
                           (max m (label-slot (:title item)))
                           m))
                       48.0
                       items)
        ;; Icon, gap, and the item's vertical padding.
        wanted (+ text-h 44.0)]
    (min (max 64.0 available) wanted)))

(defn show-new-shelf! [ctx]
  (let [ctrl (m/TextEditingController.)]
    (-> (m/showDialog
         .context ctx
         .builder
         (fn [dctx]
           (m/AlertDialog
            .title (m/Text "New shelf")
            .content (m/TextField
                      .controller ctrl
                      .autofocus true
                      .decoration (m/InputDecoration. .hintText "Name"))
            .actions
            [(m/TextButton
              .onPressed (fn [] (.pop (m/Navigator.of dctx)) nil)
              .child (m/Text "Cancel"))
             (m/TextButton
              .onPressed (fn []
                           (core/create-shelf! (.-text ctrl))
                           (.pop (m/Navigator.of dctx))
                           nil)
              .child (m/Text "Add"))])))
        (.whenComplete (fn [] (.dispose ctrl) nil)))
    nil))

(defn- shelf-row [dctx book shelf current?]
  (m/Row
   .children
   [(m/Expanded
     .child
     (m/TextButton
      .onPressed (fn []
                   (core/set-book-shelf! (.-id book) (.-id shelf))
                   (.pop (m/Navigator.of dctx))
                   nil)
      .child (m/Align
              .alignment m.Alignment/centerLeft
              .child (m/Text (.-name shelf)
                             .style (m/TextStyle
                                     .color (if current? t/primary (t/ink))
                                     .fontWeight (if current?
                                                    m.FontWeight/w600
                                                    m.FontWeight/normal))))))
    (m/IconButton
     .tooltip "Remove shelf"
     .onPressed (fn [] (core/delete-shelf! (.-id shelf)) nil)
     .icon (m/Icon m.Icons/delete_outline .color (t/ink-muted) .size 18.0))]))

(defn show-shelf-picker! [ctx book]
  (do
    (m/showDialog
     .context ctx
     .builder
     (fn [dctx]
     (f/widget
      :watch [state store/app-state]
      (let [shelves (or (:shelves state) [])
            current (.-collectionId book)]
        (m/AlertDialog
         .title (m/Text "Shelf")
         .content
         (m/SizedBox
          .width 320.0
          .height 280.0
          .child
          (m/Column
           .crossAxisAlignment m.CrossAxisAlignment/stretch
           .children
           [(m/TextButton
             .onPressed (fn []
                          (core/set-book-shelf! (.-id book) nil)
                          (.pop (m/Navigator.of dctx))
                          nil)
             .child (m/Align
                     .alignment m.Alignment/centerLeft
                     .child (m/Text "None"
                                    .style (m/TextStyle
                                            .color (if (nil? current) t/primary (t/ink))))))
            (m/Expanded
             .child
             (m/ListView
              .children (vec (map #(shelf-row dctx book % (= current (.-id %)))
                                  shelves))))
            (m/TextButton
             .onPressed (fn [] (show-new-shelf! dctx) nil)
             .child (m/Align
                     .alignment m.Alignment/centerLeft
                     .child (m/Text "New shelf")))]))
         .actions
         [(m/TextButton
           .onPressed (fn [] (.pop (m/Navigator.of dctx)) nil)
           .child (m/Text "Close"))])))))
    nil))

(defn- book-menu-items [ctx book]
  [{:type :item
    :title (if (.-favorite book) "ᠬᠠᠳᠠᠭᠠᠯᠠᠬᠤ ᠴᠡᠭᠡᠷᠯᠡᠬᠦ" "ᠬᠠᠳᠠᠭᠠᠯᠠᠬᠤ")
    :leading (if (.-favorite book) m.Icons/star_rounded m.Icons/star_outline_rounded)
    :leading-color t/accent
    :on-tap #(core/toggle-favorite! (.-id book) (not (.-favorite book)))}
   {:type :item
    :title (if (.-finished book) "ᠤᠩᠰᠢᠭᠰᠠᠨ ᠦᠭᠡᠢ" "ᠤᠩᠰᠢᠭᠰᠠᠨ")
    :leading m.Icons/check_circle_outline_rounded
    :leading-color t/success
    :on-tap #(core/set-finished! (.-id book) (not (.-finished book)))}
   {:type :item
    :title "ᠲᠠᠪᠴᠠ"
    :leading m.Icons/collections_bookmark_outlined
    :leading-color t/primary
    :on-tap #(show-shelf-picker! ctx book)}
   {:type :divider}
   {:type :item
    :title "ᠬᠠᠰᠤᠬᠤ"
    :leading m.Icons/delete_outline_rounded
    :leading-color t/danger
    :on-tap #(confirm-delete! ctx book)}])

(defn- popup-item [item close! height]
  (if (= :divider (:type item))
    (m/VerticalDivider .width 12.0 .color (t/fade (t/ink) 0.12))
    (m/InkWell
     .onTap (fn []
              (when-let [tap (:on-tap item)] (tap))
              (close!)
              nil)
     .child
     (m/SizedBox
      .height height
      .width 48.0
      .child
      (m/Padding
       .padding (m/EdgeInsets.symmetric .horizontal 6.0 .vertical 8.0)
       .child
       (m/Column
        .children
        [(m/Icon (:leading item)
                 .size 22.0
                 .color (or (:leading-color item) (t/ink)))
         (ui/gap-v 6)
         (m/Expanded
          .child
          (m/SingleChildScrollView
           .scrollDirection m.Axis/vertical
           .child
           (mgl/MongolText
            (or (:title item) "")
            .style (m/TextStyle
                    .fontFamily t/font
                    .fontSize 14.0
                    .height 1.0
                    .color (t/ink)))))]))))))

(defn- popup-card [items close! height]
  (m/Material
   .color (t/surface)
   .elevation 8.0
   .borderRadius (m/BorderRadius.circular t/radius-l)
   .clipBehavior m.Clip/antiAlias
   .child
   (m/SizedBox
    .height height
    .child
    (m/Row
     .mainAxisSize m.MainAxisSize/min
     .crossAxisAlignment m.CrossAxisAlignment/stretch
     .children (mapv #(popup-item % close! height) items)))))

(defn book-menu [ctx book]
  (f/widget
   :context host
   :let [dispose-fn (fn [a]
                      (when-let [^m/OverlayEntry entry @a]
                        (.remove entry))
                      nil)]
   :managed [layer-link (m/LayerLink.) :dispose nil
             entry-atom (atom nil)
             :dispose dispose-fn]
   (let [close! (fn []
                  (when-let [^m/OverlayEntry entry @entry-atom]
                    (.remove entry)
                    (reset! entry-atom nil))
                  nil)
         show! (fn []
                 (when (nil? @entry-atom)
                   (let [box ^m/RenderBox (.findRenderObject host)
                         origin (.localToGlobal box m/Offset.zero)
                         box-h (.-height (.-size box))
                         screen-h (.-height (.-size (m/MediaQuery.of host)))
                         top (.-dy origin)
                         below (- screen-h (+ top box-h) 12.0)
                         above (- top 12.0)
                         open-below? (>= below above)
                         available (max 64.0 (if open-below? below above))
                         items (book-menu-items ctx book)
                         height (menu-block-height items available)
                         entry (m/OverlayEntry
                                .builder
                                (fn [_]
                                  (m/Stack
                                   .children
                                   [(m/Positioned.fill
                                     .child
                                     (m/GestureDetector
                                      .behavior m.HitTestBehavior/translucent
                                      .onTap close!))
                                    (m/CompositedTransformFollower
                                     .link layer-link
                                     .showWhenUnlinked false
                                     .targetAnchor (if open-below?
                                                     m.Alignment/bottomCenter
                                                     m.Alignment/topCenter)
                                     .followerAnchor (if open-below?
                                                       m.Alignment/topCenter
                                                       m.Alignment/bottomCenter)
                                     .offset (m/Offset. 0.0 (if open-below? 4.0 -4.0))
                                     .child (popup-card items close! height))])))]
                     (reset! entry-atom entry)
                     (-> (m/Overlay.of host) (.insert entry))))
                 nil)]
     (m/CompositedTransformTarget
      .link layer-link
      .child
      (m/Material
       .color m.Colors/transparent
       .child
       (m/InkWell
        .onTap show!
        .borderRadius (m/BorderRadius.circular t/radius-s)
        .child
        (m/Padding
         .padding (m/EdgeInsets.all 6.0)
         .child (m/Icon m.Icons/more_vert_rounded
                        .color (t/ink-muted)
                        .size 20.0))))))))

;; Cover placeholder
(defn cover-placeholder
  [& {:keys [width height] :or {width 72.0 height 108.0}}]
  (m/Container
   .width width
   .height height
   .decoration (m/BoxDecoration
                .gradient (m/LinearGradient
                           .colors [t/primary-soft (t/fade t/primary-soft 0.5)]
                           .begin m.Alignment/topLeft
                           .end m.Alignment/bottomRight)
                .borderRadius (m/BorderRadius.circular t/radius-m)
                .boxShadow t/shadow-sm)
   .child (m/Center
           .child (m/Icon m.Icons/menu_book_rounded
                          .color t/primary
                          .size (* width 0.45)))))

;; Cover thumbnail
(defn cover-thumb
  [book & {:keys [width height] :or {width 72.0 height 108.0}}]
  (let [path (.-cover book)]
    (if (and path (.existsSync (io/File. path)))
      (m/Container
       .decoration (m/BoxDecoration
                    .borderRadius (m/BorderRadius.circular t/radius-m)
                    .boxShadow t/shadow-sm)
       .clipBehavior m.Clip/antiAlias
       .child
       (m/ClipRRect
        .borderRadius (m/BorderRadius.circular t/radius-m)
        .child
        (m/Image.file
         (io/File. path)
         .width width
         .height height
         .fit m/BoxFit.cover
         .errorBuilder (fn [_ _ _] (cover-placeholder :width width :height height)))))
      (cover-placeholder :width width :height height))))

;; Cover with badge
(defn cover-with-badge
  [book & {:keys [width height] :or {width 72.0 height 108.0}}]
  (m/Stack
   .children
   [(cover-thumb book :width width :height height)
    (if (.-favorite book)
      (m/Positioned
       .right 4.0
       .bottom 4.0
       .child
       (m/Container
        .padding (m/EdgeInsets.all 4.0)
        .decoration (m/BoxDecoration
                     .color m.Colors/white
                     .borderRadius (m/BorderRadius.circular t/radius-xs)
                     .boxShadow t/shadow-sm)
        .child (m/Icon m.Icons/star_rounded .color t/accent .size 14.0)))
      (m/SizedBox.shrink))]))

;; Book card
(defn library-card
  [ctx book & {:keys [height margin opened] :or {height 240.0}}]
  (let [author (or (.-author book) "")
        progress (.-progress book)]
    (ui/card-shell
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/stretch
      .children
      [(cover-with-badge book :width 72.0 :height 108.0)
       (ui/gap-h 10)
       (m/Expanded
        .child
        (m/Column
         .crossAxisAlignment m.CrossAxisAlignment/start
         .mainAxisAlignment m.MainAxisAlignment/spaceBetween
         .children
         [(m/Column
           .crossAxisAlignment m.CrossAxisAlignment/start
           .children
           [(ui/text (or (.-title book) "ᠨᠡᠷᠡᠢᠳᠦᠭᠡᠢ")
                     {:size 17.0 :weight m.FontWeight/w600 :max-lines 2})
            (when (seq author)
              (m/Padding
               .padding (m/EdgeInsets.only .top 6.0)
               .child (ui/text author {:size 13.0 :color (t/ink-muted) :max-lines 1})))
            (when (seq (or opened ""))
              (m/Padding
               .padding (m/EdgeInsets.only .top 6.0)
               .child (ui/text opened {:size 11.0 :color (t/ink-faint) :max-lines 1})))])
          (when (> progress 0.0)
            (m/Column
             .crossAxisAlignment m.CrossAxisAlignment/start
             .children
             [(ui/text (str (int (* progress 100)) "%")
                       {:size 11.0 :color t/primary :weight m.FontWeight/w500})
              (ui/gap-v 3)
              (m/Container
               .height 2.5
               .decoration (m/BoxDecoration
                            .color (t/surface-2)
                            .borderRadius (m/BorderRadius.circular 2.0))
               .child
               (m/FractionallySizedBox
                .widthFactor progress
                .child
                (m/Container
                 .decoration (m/BoxDecoration
                              .gradient (m/LinearGradient
                                         .colors [t/primary t/primary-deep])
                              .borderRadius (m/BorderRadius.circular 2.0)))))]))]))
       (ui/gap-h 8)
       (ui/v-progress progress)
       (m/Align
        .alignment m.Alignment/topCenter
        .child (book-menu ctx book))])
     :width 210.0
     :height height
     :margin margin
     :padding 14.0
     :on-tap (fn []
               (core/open-library-book! (.-id book))
               nil))))

(defn- filter-chip [selected [id label]]
  (m/Container
   .margin (m/EdgeInsets.symmetric .vertical 4.0)
   .decoration (when (= id selected)
                 (m/BoxDecoration
                  .color t/primary-soft
                  .borderRadius (m/BorderRadius.circular t/radius-m)
                  .border (m/Border.all .color t/primary .width 2.0)))
   .child
   (m/Material
    .color m.Colors/transparent
    .child
    (m/InkWell
     .onTap #(store/set-library-filter! id)
     .borderRadius (m/BorderRadius.circular t/radius-m)
     .child
     (m/Padding
      .padding (m/EdgeInsets.symmetric .horizontal 12.0 .vertical 12.0)
      .child
      (t/mongol-label label
                      :size 14.0
                      :color (if (= id selected) t/primary (t/ink-muted))
                      :weight (if (= id selected) m.FontWeight/w600 m.FontWeight/normal)))))))

;; Filter rail. [shelves] are Shelf rows from the store; their ids are strings.
(defn filter-rail [selected shelves]
  (let [custom (mapv (fn [s] [(.-id s) (.-name s)]) (or shelves []))]
    (m/Column
     .mainAxisSize m.MainAxisSize/min
     .children
     (conj (mapv #(filter-chip selected %) (concat filters custom))
           (m/Builder
            .builder
            (fn [ctx]
              (m/Padding
               .padding (m/EdgeInsets.only .top 8.0)
               .child
               (m/IconButton
                .tooltip "New shelf"
                .onPressed (fn [] (show-new-shelf! ctx) nil)
                .icon (m/Icon m.Icons/add .color t/primary .size 20.0)))))))))
